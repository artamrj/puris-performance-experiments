#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# lab – Einstiegspunkt des Experiments (KONZEPT.md, Abschnitt 4).
#
# Stand 2026-10-07: nur der vorgezogene Teil (KONZEPT.md, Abschnitt 1) –
# Reset und Messlauf; status/up/down/refresh folgen mit Etappe 2.
#
#   ./lab snapshot <name>     Datenbank-Stand sichern (alle 7 Datenbanken) nach
#                             $STATE_DIR/<name>; bricht ab, wenn es ihn schon gibt
#   ./lab reset <name>        Ausgangszustand herstellen: PURIS und EDC beider
#                             Firmen anhalten, ihre Datenbanken auf <name>
#                             zurücksetzen, Zeilen aller 7 Datenbanken prüfen, ANALYZE,
#                             Registrierung der Data Planes löschen, dann Control
#                             Planes → Data Planes → PURIS starten
#   ./lab run <plan> <rep>    Messlauf nach experiments/plans/<plan>.env:
#                             Vorprüfung → Reset → Funktionstest → k6-TestRun →
#                             Abarbeiten abwarten → Sammeln nach
#                             runs/<Zeit>_<plan>_rep-<rep>/ (nur auf der VM, nur bei
#                             sauberem Git-Stand)
#   ./lab series <plan> <n>   Messreihe: Wiederholungen 1..n nacheinander; ein
#                             gescheiterter Lauf hält die Reihe nicht an, er wird
#                             einmal durch eine weitere Wiederholung ersetzt;
#                             Übersicht in $STATE_DIR/logs/series-<plan>.txt
#   ./lab status              Zustand: letzte Meldung, Sperre, PURIS/EDC vollständig?
#   ./lab check               Funktionstest: 3 echte Transaktionen nacheinander (ohne Reset)
#
# Sicherheitsnetz (lib/stack.sh, seit 2026-10-07): nur ein Befehl gleichzeitig (Sperre);
# geordneter Start mit genau einer Reparatur je Stufe (nur im Reset, in meta.json
# festgehalten); nach einem Fehler oder Abbruch stoppt das sichere Ende die Last und
# startet PURIS und EDC geordnet wieder – das System bleibt nie halb angehalten.
#
# Läuft dort, wo kubectl den Versuchscluster erreicht (Mac mit `puris` oder VM);
# `run` nur auf der VM (KONZEPT.md, Abschnitt 5).
# ══════════════════════════════════════════════════════════════════════════════
set -euo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib/db.sh
. lib/db.sh

die() { echo "Abbruch: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { echo "[$(date -u +%H:%M:%S)] $*"; }
# shellcheck source=lib/stack.sh
. lib/stack.sh

# Deployments, die der Reset anhält und neu startet (je Firma).
APPS_EDC="edc-controlplane edc-dataplane"
APPS_PURIS="puris-backend"

cmd_snapshot() {
  local name="${1:?Name fehlt, z. B. s0-v2}" d="$STATE_DIR/${1:-}" n
  [ ! -e "$d" ] || die "$d existiert bereits (Stände nie überschreiben)"
  mkdir -p "$d"
  for n in $(db_names); do
    db_cmd "$n" pg_dump "-Fc" > "$d/$n.dump"
    db_counts "$n" > "$d/$n.zeilen.txt"
    log "$n: $(du -h "$d/$n.dump" | cut -f1), $(wc -l < "$d/$n.zeilen.txt") Tabellen, $(awk '{s+=$2} END {print s}' "$d/$n.zeilen.txt") Zeilen"
  done
  now > "$d/zeitpunkt.txt"
  git rev-parse HEAD > "$d/commit.txt"
  (cd "$d" && sha256sum ./*.dump ./*.zeilen.txt > SHA256SUMS)
  chmod -R go-rwx "$STATE_DIR"
  log "Stand $name gesichert: $d"
}

# Zeilen aller 7 Datenbanken gegen den Stand vergleichen; gibt Abweichungen aus.
check_counts() {
  local d="$1" n diffs="" out
  for n in $(db_names); do
    out="$(diff <(sort "$d/$n.zeilen.txt") <(db_counts "$n" | sort) | grep '^[<>]' || true)"
    [ -z "$out" ] || diffs+="$n: $(echo "$out" | tr '\n' ' ')"$'\n'
  done
  printf %s "$diffs"
}

pods_gone() {
  local ns="$1" app
  for app in $APPS_EDC $APPS_PURIS; do
    kubectl get pods -n "$ns" --no-headers 2>/dev/null | grep -q "^$app-" && return 1
  done
  return 0
}

cmd_reset() {
  local name="${1:?Name des Stands fehlt, z. B. s0-v2}" d="$STATE_DIR/${1:-}" t0 ns n i diffs after
  [ -d "$d" ] || die "Stand $d fehlt"
  (cd "$d" && sha256sum -c --quiet SHA256SUMS) || die "Prüfsummen von $d stimmen nicht"
  t0=$(date +%s)
  log "Reset auf $name"; status "Reset auf $name läuft"
  REPAIRS=()
  # 1. kein laufender Lastgenerator
  load_active && die "ein TestRun ist noch nicht beendet"
  # 2. PURIS und EDC beider Firmen anhalten (Hintergrundaufträge enden mit)
  for ns in customer supplier; do
    # shellcheck disable=SC2086
    kubectl scale deploy $APPS_PURIS $APPS_EDC -n "$ns" --replicas=0 >/dev/null
  done
  for i in $(seq 1 60); do pods_gone customer && pods_gone supplier && break; sleep 5; done
  pods_gone customer && pods_gone supplier || die "Pods nach 300 s nicht beendet"
  log "PURIS und EDC angehalten"
  # 3. Datenbanken zurücksetzen (eine Transaktion je Datenbank)
  for n in $RESET_DBS; do
    db_cmd "$n" pg_restore "--clean --if-exists --single-transaction --exit-on-error" < "$d/$n.dump"
  done
  # 4. Zeilen aller 7 Datenbanken = Stand
  diffs="$(check_counts "$d")"
  [ -z "$diffs" ] || die "Zeilen weichen vom Stand ab:"$'\n'"$diffs"
  # Planer-Statistiken sofort erzeugen: pg_restore stellt keine wieder her; sonst entstehen
  # sie erst durch Autovacuum zu zufälligen Zeitpunkten während der Last (Vorstudie 1).
  for n in $RESET_DBS; do db_cmd "$n" psql "-q -c 'SET client_min_messages TO error; ANALYZE'" >/dev/null; done
  log "Datenbanken auf $name, Zeilen aller 7 Datenbanken gleich, ANALYZE ausgeführt"
  # Registrierung der Data Plane löschen: Die Data Plane meldet sich bei jedem Start selbst
  # neu an. Eine wiederhergestellte, beim Start nicht erreichbare Registrierung macht die
  # Control Plane „nicht bereit“; dann erreicht die Data Plane sie über den Dienst nicht
  # und startet neu – gegenseitiges Warten (Reset 2026-10-07, 13:51 UTC).
  for ns in customer supplier; do dp_registration_clear "$ns"; done
  # 5. Reihenfolge: Control Planes → Data Planes (melden sich bei der bereiten Control
  #    Plane an) → PURIS (spricht beim Start den EDC an); je Stufe höchstens eine
  #    Reparatur (lib/stack.sh), festgehalten in last-reset.json
  start_stack 1 || die "PURIS/EDC nach Reparatur nicht bereit"
  # 6. Zeilen nach dem Start (Schreibzugriffe beim Start werden festgehalten)
  after="$(check_counts "$d")"
  jq -n --arg state "$name" --arg start "$(date -u -r "$t0" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$t0" +%Y-%m-%dT%H:%M:%SZ)" \
    --arg end "$(now)" --argjson dur "$(( $(date +%s) - t0 ))" --arg after "$after" \
    --arg repairs "${REPAIRS[*]+${REPAIRS[*]}}" \
    '{state: $state, start_utc: $start, end_utc: $end, duration_s: $dur, counts_equal_after_restore: true,
      counts_diff_after_start: ($after | split("\n") | map(select(. != ""))),
      repairs: ($repairs | split(" ") | map(select(. != "")))}' > "$STATE_DIR/last-reset.json"
  log "Reset fertig nach $(( $(date +%s) - t0 )) s${after:+; nach dem Start abweichend: $after}${REPAIRS[*]+; Reparaturen: ${REPAIRS[*]}}"
  status "Reset auf $name fertig${REPAIRS[*]+ (Reparaturen: ${REPAIRS[*]})}"
}

cmd_run() {
  local plan="${1:?Plan fehlt, z. B. vorstudie}" rep="${2:?Wiederholung fehlt, z. B. 1}"
  local pf="experiments/plans/$plan.env" commit tag stamp run_id run_dir name tmp t_apply n_stages total key
  [ -r /etc/rancher/k3s/k3s.yaml ] || die "Messläufe nur auf der VM (KONZEPT.md, Abschnitt 5)"
  [ -r "$pf" ] || die "$pf fehlt"
  # Sauber = keine Änderung an versionierten Dateien und nichts Neues außerhalb von runs/
  # (neue Laufordner einer Messreihe ändern den gemessenen Aufbau nicht)
  [ -z "$(git status --porcelain | grep -v '^?? runs/' || true)" ] || die "Git-Stand nicht sauber (KONZEPT.md, Abschnitt 6)"
  set -a; # shellcheck disable=SC1090
  . "$pf"; set +a
  export PLAN="$plan" REP="$rep"
  commit=$(git rev-parse HEAD); tag=$(git describe --tags --exact-match 2>/dev/null || true)
  stamp=$(date -u +%Y-%m-%d_%H%M); run_id="${stamp}_${plan}_rep-${rep}"; run_dir="runs/$run_id"
  [ ! -e "$run_dir" ] || die "$run_dir existiert bereits"
  name=$(echo "${plan}-r${rep}-$(date -u +%H%M)" | tr 'A-Z_' 'a-z-')
  tmp=$(mktemp -d)
  log "Lauf $run_id (Plan $plan, Commit ${commit:0:7}${tag:+, Tag $tag})"
  precheck

  cmd_reset "$STATE"
  # Funktionstest: drei echte Transaktionen nacheinander müssen durchlaufen, sonst keine Last
  status "Funktionstest ($run_id)"
  function_test 3 || die "Funktionstest nach dem Reset fehlgeschlagen: $FUNCTION_TEST"
  log "Funktionstest bestanden: $FUNCTION_TEST"
  jq --argjson ft "$FUNCTION_TEST" '. + {function_test: $ft}' "$STATE_DIR/last-reset.json" > "$tmp/reset.json"

  # Skript als ConfigMap aus dem Commit; alte TestRuns entfernen (Daten gesammelt)
  kubectl delete testrun --all -n k6 --wait=true >/dev/null
  kubectl create configmap k6-stock-trigger -n k6 --from-file=stock-trigger.js=experiments/k6/stock-trigger.js \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  python3 experiments/k6/render_testrun.py "$name" "$run_id" > "$tmp/testrun.json"
  t_apply=$(now)
  kubectl apply -f "$tmp/testrun.json" >/dev/null
  n_stages=$(echo "$RATES" | tr ',' '\n' | wc -l)
  total=$(( n_stages * STAGE_DURATION + 10 ))
  log "TestRun $name gestartet, $n_stages Stufen à $STAGE_DURATION min (Ende spätestens nach $total min)"
  status "Last läuft: $run_id (TestRun $name, Ende spätestens $(date -u -d "+$total min" +%H:%M 2>/dev/null || echo '?') UTC)"
  kubectl wait --for=jsonpath='{.status.stage}'=finished "testrun/$name" -n k6 --timeout="${total}m" >/dev/null
  log "TestRun beendet; warte auf offene Transaktionen und sammle"; status "Sammeln: $run_id"

  python3 experiments/collect/collect_run.py "$run_dir" "$name" "$run_id" "$t_apply" "$commit" "$tag" "$tmp"
  mkdir -p "$run_dir/db"
  for n in $(db_names); do db_counts "$n" > "$run_dir/db/$n.zeilen-nach-lauf.txt"; done

  # Geheimnisse: API-Key darf nicht im Laufordner stehen (Wert wird nie ausgegeben)
  key=$(kubectl get secret secret-puris-backend -n customer -o jsonpath='{.data.puris-api-key}' | base64 -d)
  if grep -rqF -- "$key" "$run_dir" || find "$run_dir" -name '*.gz' -exec zgrep -qF -- "$key" {} \; -print | grep -q .; then
    die "API-Key im Laufordner gefunden – Lauf nicht verwenden, Dateien prüfen"
  fi
  unset key

  (cd "$run_dir" && find . -type f ! -name SHA256SUMS | LC_ALL=C sort | xargs sha256sum > SHA256SUMS)
  rm -rf "$tmp"
  log "Fertig: $run_dir ($(du -sh "$run_dir" | cut -f1)); Gültigkeit: $(jq -c .validity "$run_dir/meta.json")"
  status "Fertig: $run_dir – gültig: $(jq -r .validity.valid "$run_dir/meta.json")"
}

# Messreihe: jede Wiederholung als eigener Prozess (ein Fehler beendet nur diesen Lauf;
# das sichere Ende stellt das System wieder her). Je gescheitertem Lauf eine Ersatz-
# Wiederholung (höchstens so viele wie Läufe geplant).
cmd_series() {
  local plan="${1:?Plan fehlt}" n="${2:?Anzahl fehlt}" rep rc dir valid failed=0 next ov="$STATE_DIR/logs/series-${1:-}.txt"
  [ -r "experiments/plans/$plan.env" ] || die "experiments/plans/$plan.env fehlt"
  mkdir -p "$STATE_DIR/logs"
  echo "[$(now)] Messreihe $plan, $n Wiederholungen, Commit $(git rev-parse --short HEAD)" >> "$ov"
  run_one() {
    local r="$1" before
    before=$(ls -d runs/*_"${plan}"_rep-"$r" 2>/dev/null || true)
    rc=0; ./lab run "$plan" "$r" || rc=$?
    # nur der in diesem Lauf neu entstandene Laufordner
    dir=$(comm -13 <(echo "$before") <(ls -d runs/*_"${plan}"_rep-"$r" 2>/dev/null || true) | tail -1)
    valid=$( [ -n "$dir" ] && [ -f "$dir/meta.json" ] && jq -r .validity.valid "$dir/meta.json" || echo "-")
    echo "[$(now)] rep-$r: Ende-Code $rc, gültig $valid, ${dir:-kein Laufordner}" >> "$ov"
    [ "$rc" -eq 0 ] && [ "$valid" = true ]
  }
  for rep in $(seq 1 "$n"); do run_one "$rep" || failed=$((failed + 1)); done
  # je gescheitertem oder ungültigem Lauf genau ein Ersatzversuch
  next=$((n + 1))
  while [ "$failed" -gt 0 ]; do
    echo "[$(now)] Ersatz für einen gescheiterten oder ungültigen Lauf: rep-$next" >> "$ov"
    run_one "$next" || true
    next=$((next + 1)); failed=$((failed - 1))
  done
  echo "[$(now)] Messreihe $plan beendet" >> "$ov"; cat "$ov"
}

cmd_status() {
  echo "Letzte Meldung: $(cat "$STATUS_FILE" 2>/dev/null || echo '–')"
  if [ -d "$LOCK" ]; then echo "Sperre: PID $(cat "$LOCK/pid" 2>/dev/null) – $(cat "$LOCK/cmd" 2>/dev/null)"; else echo "Sperre: frei"; fi
  if stack_healthy; then echo "PURIS und EDC: vollständig (6/6 bereit)"; else
    echo "PURIS und EDC: UNVOLLSTÄNDIG"
    for ns in $SUT_NS; do kubectl get deploy -n "$ns" $SUT_APPS --no-headers 2>/dev/null | sed "s/^/  $ns: /"; done
  fi
  if load_active; then echo "Last: TestRun aktiv"; else echo "Last: keine"; fi
}

trap safe_exit EXIT
trap 'exit 130' INT TERM HUP
case "${1:-}" in
  snapshot) lock_acquire "$*"; shift; cmd_snapshot "$@" ;;
  reset)    lock_acquire "$*"; shift; cmd_reset "$@" ;;
  run)      lock_acquire "$*"; shift; cmd_run "$@" ;;
  series)   shift; cmd_series "$@" ;;
  status)   cmd_status ;;
  check)    lock_acquire "$*"; function_test 3 || die "Funktionstest fehlgeschlagen: $FUNCTION_TEST"; log "Funktionstest bestanden: $FUNCTION_TEST" ;;
  *) sed -n '2,33p' "$0"; exit 2 ;;
esac
