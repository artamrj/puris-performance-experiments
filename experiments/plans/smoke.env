# Messplan: Kurztest der Messkette (`./lab run smoke 1`) – kein Messlauf für die Auswertung.
# Prüft Reset, TestRun aus dem Plan, Verteilung auf die Materialien, Sammeln.
PLAN_KIND="smoke"
STATE="s0-v2"            # Ausgangszustand für den Reset ($STATE_DIR/<STATE>)
RATES="0.5,1"            # Auslösungen je Sekunde je Stufe
STAGE_DURATION="1"       # Minuten je Stufe
DRAIN_MAX_MIN="5"        # höchstens so lange auf offene Transaktionen warten
STEAL_MAX="0.02"         # vorläufiger Grenzwert Steal Time (Vorstudie legt ihn fest)
