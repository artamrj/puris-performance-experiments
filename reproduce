# ── Lock, job, markers ────────────────────────────────────────────────────────────
LOCKED=0
lock() {
  command -v flock >/dev/null || { fail "program flock missing – install it with: sudo apt-get install -y util-linux"; exit 3; }
  exec 9>"$STATE/lock"
  if ! flock -n 9; then
    fail "another reproduce job is already running ($(sed -n 's/.*command=\([^ ]*\).*phase=\([^ ]*\).*/command \1, phase \2/p' "$STATE/job" 2>/dev/null || echo unknown))"
    hint "follow it: ./reproduce watch · stop it: ./reproduce stop"
    exit 1
  fi
  LOCKED=1
  printf 'pid=%s command=%s phase=%s started=%s since=%s mode=%s reps=%s\n' "$$" "${CMD:-}" "start" "$(now_iso)" "$(date +%s)" \
    "$( [ "${REPRODUCE_SMOKE:-0}" = 1 ] && echo short || echo full)" "$REPS" > "$STATE/job"
  [ "$BG" != 1 ] || info "background job started (PID $$)"
}
unlock() { [ "$LOCKED" = 1 ] || return 0; flock -u 9; exec 9>&-; LOCKED=0; }
set_phase() {
  case "${CURRENT_PHASE:-}:$1" in measure*:verify) return 0 ;; esac   # the check before every configuration stays part of "measure"
  CURRENT_PHASE="$1"
  [ -f "$STATE/job" ] && sed -i.bak -e "s/ phase=[^ ]*/ phase=$1/" -e "s/ since=[^ ]*/ since=$(date +%s)/" "$STATE/job" && rm -f "$STATE/job.bak"; return 0
}
job_field() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" "$STATE/job" 2>/dev/null; }
res_field() { local d; d=$(cat "$STATE/results-current" 2>/dev/null) && cat "$d/.$1" 2>/dev/null; }   # mode/reps of the current results folder
eff_reps() {  # target runs: running job > REPRODUCE_REPS of this shell > current results folder > default
  local r=""; if job_alive; then r=$(job_field reps); elif [ -z "${REPRODUCE_REPS:-}" ]; then r=$(res_field reps || true); fi; echo "${r:-$REPS}"
}
is_short() {  # short test: this shell, the running job, or (without either) the current results folder
  [ "${REPRODUCE_SMOKE:-0}" = 1 ] && return 0
  if job_alive; then [ "$(job_field mode)" = short ]; elif [ -z "${REPRODUCE_SMOKE:-}" ]; then [ "$(res_field mode || true)" = short ]; else return 1; fi
}
job_pid() { sed -n 's/^pid=\([0-9]*\).*/\1/p' "$STATE/job" 2>/dev/null; }
job_alive() { local p; p=$(job_pid); [ -n "$p" ] && [ "$p" != "$$" ] && kill -0 "$p" 2>/dev/null; }
marker_set()   { printf '%s\n' "${2:-$(now_iso)}" > "$MARKERS/$1"; }
marker_clear() { rm -f "$MARKERS/$1"; }
marker_has()   { [ -f "$MARKERS/$1" ]; }
marker_get()   { cat "$MARKERS/$1" 2>/dev/null; }

# Background job: survives a lost SSH connection (REPRODUCE.md §22.1).
detach() {  # command... → continues as a background job and shows its progress
  [ "$BG" = 1 ] && return 0
  if job_alive; then   # refuse before anything is started or copied
    fail "another reproduce job is already running (command $(sed -n 's/.*command=\([^ ]*\).*/\1/p' "$STATE/job"), phase $(sed -n 's/.*phase=\([^ ]*\).*/\1/p' "$STATE/job"))"
    hint "follow it: ./reproduce watch · stop it: ./reproduce stop"; exit 1
  fi
  unlock
  local pos js; : >> "$LOGF"; pos=$(stat -c %s "$LOGF")   # the log exists before the view follows it
  # the job runs from its own copy: downloading a new ./reproduce never changes a running job
  # (bash reads a script while running it – an overwritten file would be read at the old position)
  js=$(mktemp "$STATE/job-script.XXXXXX"); cp "$SCRIPT" "$js"; rm -f "$STATE/job-exit"
  REPRODUCE_BG=1 REPRODUCE_HOME="$WORK" setsid nohup bash "$js" "$@" </dev/null >/dev/null 2>&1 &
  echo
  printf '%s\n' "${C_DIM}  The next steps run in the background (PID $!). Closing this terminal or losing the SSH connection does not stop them.${C_0}"
  printf '%s\n' "${C_DIM}  Ctrl-C closes only this view · ./reproduce dashboard (live overview) · watch · status · stop${C_0}"
  [ -z "$SUDO_KEEP" ] || kill "$SUDO_KEEP" 2>/dev/null || true
  cmd_watch --from "$pos"
  exit "$(cat "$STATE/job-exit" 2>/dev/null || echo 0)"   # the job's exit code, so that "./reproduce measure && …" stops after a failure
}

# ── Common helpers ────────────────────────────────────────────────────────────────
profile() { cat "$STATE/profile" 2>/dev/null; }
configs_of() { local v="CONFIGS_$1"; echo "${!v:-}"; }
commit() { git -C "$SRC" rev-parse HEAD 2>/dev/null; }
k() { kubectl --request-timeout=30s "$@"; }
release_line() { echo "$RELEASES" | awk -v b="$1" '$1 == b'; }
chart_ref() {  # block → local chart archive
  local b="$1" _r _n chart _repo ver _s
  read -r _ _r _n chart _repo ver _s <<<"$(release_line "$b")"
  case "$chart" in PURIS) echo "$STATE/charts/puris-$ver.tgz" ;; *) echo "$STATE/charts/$(basename "$chart")-$ver.tgz" ;; esac
}
cp_limit_of() { case "$1" in compact-k0) echo 0.5 ;; compact-k1) echo 1.0 ;; *) echo 1.5 ;; esac; }
plan_of() { case "$1" in compact-k0) echo k0 ;; compact-k1) echo k1 ;; *) echo "$1" ;; esac; }

# values files of one release in one configuration (REPRODUCE.md §7)
values_files() {  # block configuration → one path per line
  local b="$1" cfg="$2" prof="${2%%-*}" sut base out
  sut=$(release_line "$b" | awk '{print $7}')
  base="$SRC/setup/$b/values.yaml"
  if [ "$prof" = original ] && [ "$sut" = 1 ]; then
    out="$STATE/values/$cfg/$b.yaml"; mkdir -p "$(dirname "$out")"
    py strip "$base" "$out"; echo "$out"
  else
    echo "$base"
  fi
  [ "$b" != b3-alloy ] || echo "$SRC/setup/b3-alloy/reproduce.yaml"
  case "$b" in d1-*|d2-*) passwords_file; ;; esac
  case "$cfg" in
    compact-k1)  [ ! -f "$SRC/setup/$b/k1-nas.yaml" ] || echo "$SRC/setup/$b/k1-nas.yaml" ;;
    original-k1) [ ! -f "$SRC/setup/$b/original-k1.yaml" ] || echo "$SRC/setup/$b/original-k1.yaml" ;;
  esac
}
passwords_file() {
  local f="$STATE/values/puris-test-passwords.yaml"; mkdir -p "$STATE/values"
  [ -f "$f" ] || cat > "$f" <<EOF
# test only – fixed public values (REPRODUCE.md §7.5)
backend:
  puris:
    api: { key: "$TEST_API_KEY" }
    datasource: { password: "$TEST_DB_PASSWORD" }
    erpadapter: { authsecret: "$TEST_DB_PASSWORD" }
postgresql:
  auth: { password: "$TEST_DB_PASSWORD" }
  customUser: { password: "$TEST_DB_PASSWORD" }
EOF
  echo "$f"
}
render() {  # block configuration out-file
  local b="$1" cfg="$2" out="$3" ns args=() f
  ns=$(release_line "$b" | awk '{print $3}')
  while IFS= read -r f; do [ -f "$f" ] || { echo "values file missing: $f" >>"$LOGF"; return 1; }; args+=(-f "$f"); done < <(values_files "$b" "$cfg")
  helm template "$(release_line "$b" | awk '{print $2}')" "$(chart_ref "$b")" -n "$ns" --kube-version "${KUBECTL_VERSION#v}" "${args[@]}" > "$out" 2>>"$LOGF"
}
desired_hash() {  # block configuration
  local b="$1" cfg="$2" f
  { chart_ref "$b"; while IFS= read -r f; do cat "$f"; done < <(values_files "$b" "$cfg"); } | sha256sum | cut -c1-16
}

# ── Databases (pod environment holds the credentials) ─────────────────────────────
DB_LIST='identity wallet-postgres-0 c1-wallet POSTGRES_USER POSTGRES_PASSWORD postgres
customer edc-postgresql-0 c2-customer-edc POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DATABASE
customer dtr-postgresql-0 c3-customer-dtr POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DATABASE
supplier edc-postgresql-0 c4-supplier-edc POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DATABASE
supplier dtr-postgresql-0 c5-supplier-dtr POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DATABASE
customer puris-postgresql-0 d1-puris-customer CUSTOM_USER CUSTOM_PASSWORD CUSTOM_DB
supplier puris-postgresql-0 d2-puris-supplier CUSTOM_USER CUSTOM_PASSWORD CUSTOM_DB'
RESET_DBS="c2-customer-edc c4-supplier-edc d1-puris-customer d2-puris-supplier"
ROWS_SQL="select table_schema||'.'||table_name, (xpath('/row/c/text()', query_to_xml(format('select count(*) as c from %I.%I', table_schema, table_name), false, true, '')))[1]::text from information_schema.tables where table_schema not in ('pg_catalog','information_schema') and table_type='BASE TABLE' order by 1;"
db_names() { echo "$DB_LIST" | awk '{print $3}'; }
db_cmd() {  # name program "args"
  local ns pod _n uv pv dv db
  read -r ns pod _n uv pv dv <<<"$(echo "$DB_LIST" | awk -v n="$1" '$3 == n')"
  if [ "$dv" = postgres ]; then db=postgres; else db="\$$dv"; fi
  kubectl --request-timeout=180s exec -i -n "$ns" "$pod" -- sh -c "PGPASSWORD=\"\$$pv\" exec $2 -h 127.0.0.1 -U \"\$$uv\" -d \"$db\" ${3:-}"
}
db_counts() { db_cmd "$1" psql "-v ON_ERROR_STOP=1 -At -F ' ' -f -" <<<"$ROWS_SQL"; }
counts_diff() {  # dbs... → prints differences against S0
  local n out
  for n in "$@"; do
    out=$(diff <(LC_ALL=C sort "$STATE/s0/$n.rows.txt") <(db_counts "$n" | LC_ALL=C sort) | grep '^[<>]' || true)
    [ -z "$out" ] || echo "$n: $(echo "$out" | tr '\n' ' ')"
  done
}

# ── System under test: stop and ordered start (lessons of LABORBUCH.md 2026-10-07) ─
SUT_NS="customer supplier"; SUT_APPS="puris-backend edc-dataplane edc-controlplane"
scale() { k scale deploy "$2" -n "$1" --replicas="$3" >/dev/null; }
wait_ready() { kubectl --request-timeout=30s rollout status "deploy/$2" -n "$1" --timeout="${3}s" >/dev/null 2>&1; }
wait_gone() {
  local i
  for i in $(seq 1 60); do
    [ -z "$(k get pods -n "$1" -o name 2>/dev/null | grep "pod/$2-" || true)" ] && return 0
    sleep 5
  done
  return 1
}
dp_clear() { local db=c2-customer-edc; [ "$1" = supplier ] && db=c4-supplier-edc; db_cmd "$db" psql "-v ON_ERROR_STOP=1 -q -c 'DELETE FROM edc_data_plane_instance'" >/dev/null; }
stop_sut() {
  local ns a
  for ns in $SUT_NS; do for a in $SUT_APPS; do scale "$ns" "$a" 0; done; done
  for ns in $SUT_NS; do for a in $SUT_APPS; do wait_gone "$ns" "$a" || return 1; done; done
}
REPAIRS=""
start_sut() {  # control planes → data planes → PURIS; per stage at most one known repair (REPRODUCE.md §10.2)
  local ns
  for ns in $SUT_NS; do scale "$ns" edc-controlplane 1; done
  for ns in $SUT_NS; do
    wait_ready "$ns" edc-controlplane 300 && continue
    warn "repair: control plane $ns not ready after 5 min – restart without data plane registration"
    REPAIRS="$REPAIRS controlplane-$ns"
    scale "$ns" edc-dataplane 0; wait_gone "$ns" edc-dataplane || return 1
    scale "$ns" edc-controlplane 0; wait_gone "$ns" edc-controlplane || return 1
    dp_clear "$ns"; scale "$ns" edc-controlplane 1; wait_ready "$ns" edc-controlplane 300 || return 1
  done
  for ns in $SUT_NS; do scale "$ns" edc-dataplane 1; done
  for ns in $SUT_NS; do
    wait_ready "$ns" edc-dataplane 240 && continue
    warn "repair: data plane $ns not ready after 4 min – restart both planes without registration"
    REPAIRS="$REPAIRS dataplane-$ns"
    scale "$ns" edc-dataplane 0; wait_gone "$ns" edc-dataplane || return 1
    scale "$ns" edc-controlplane 0; wait_gone "$ns" edc-controlplane || return 1
    dp_clear "$ns"; scale "$ns" edc-controlplane 1; wait_ready "$ns" edc-controlplane 300 || return 1
    scale "$ns" edc-dataplane 1; wait_ready "$ns" edc-dataplane 240 || return 1
  done
  for ns in $SUT_NS; do scale "$ns" puris-backend 1; done
  for ns in $SUT_NS; do
    wait_ready "$ns" puris-backend 600 && continue
    warn "repair: PURIS $ns not ready after 10 min – restart"
    REPAIRS="$REPAIRS puris-$ns"
    scale "$ns" puris-backend 0; wait_gone "$ns" puris-backend || return 1
    scale "$ns" puris-backend 1; wait_ready "$ns" puris-backend 600 || return 1
  done
}

# function test: n real transactions one after another (REPRODUCE.md §10.2)
FT_JSON='{}'
function_test() {
  local n="${1:-3}" okn=0 m t0 s0 code deadline logs
  t0=$(now_iso); s0=$(date +%s)
  local before
  for m in $(grep -v '^#' "$SRC/setup/e1-testdaten/materialien.tsv" | tail -n +2 | cut -f2 | head -n "$n"); do
    before=$okn
    code=$(py trigger "$TEST_API_KEY" "$m" 2>>"$LOGF" || echo error)
    [ "$code" = 200 ] || break
    deadline=$(( $(date +%s) + 120 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      logs=$(k logs -n customer deploy/puris-backend --since-time="$t0" 2>/dev/null || true)
      if grep -q "Updated ReportedMaterialItemStocks for $m and" <<<"$logs"; then okn=$((okn + 1)); break; fi
      grep -q "Error in ReportedMaterialItemStockRequest for $m and" <<<"$logs" && break
      sleep 2
    done
    [ "$okn" -gt "$before" ] || break
  done
  FT_JSON="{\"transactions\": $n, \"completed\": $okn, \"seconds\": $(( $(date +%s) - s0 )), \"passed\": $([ "$okn" -eq "$n" ] && echo true || echo false)}"
  [ "$okn" -eq "$n" ]
}

load_active() { k get testrun -n k6 -o jsonpath='{range .items[*]}{.metadata.name}={.status.stage}{"\n"}{end}' 2>/dev/null | grep -v '=finished$' | grep -q .; }
stop_own_load() { k delete testrun -n k6 -l reproduce=1 --ignore-not-found --wait=true --timeout=120s >/dev/null 2>&1 || true; }

reset_sut() {  # → state/last-reset.json
  local t0 diffs after
  t0=$(date +%s); REPAIRS=""
  [ -f "$STATE/s0/SHA256SUMS" ] || die "database state S0 missing ($(rel "$STATE/s0")) – run ./reproduce prepare"
  ( cd "$STATE/s0" && sha256sum -c --quiet SHA256SUMS ) || die "S0 checksums do not match – the saved database state was changed; run ./reproduce prepare"
  load_active && stop_own_load
  marker_set reset
  step "reset: stop PURIS and EDC"
  stop_sut || die "reset: PURIS/EDC did not stop"
  step "reset: restore 4 databases from S0, ANALYZE, clear data plane registration"
  for n in $RESET_DBS; do db_cmd "$n" pg_restore "--clean --if-exists --single-transaction --exit-on-error" < "$STATE/s0/$n.dump" || die "reset: restore failed: $n"; done
  # shellcheck disable=SC2046
  diffs=$(counts_diff $(db_names)); [ -z "$diffs" ] || die "reset: rows differ from S0: $diffs"
  for n in $RESET_DBS; do db_cmd "$n" psql "-v ON_ERROR_STOP=1 -q -c 'SET client_min_messages TO error; ANALYZE'" >/dev/null || die "reset: ANALYZE failed: $n"; done
  dp_clear customer; dp_clear supplier
  step "reset: start control planes → data planes → PURIS"
  start_sut || die "reset: PURIS/EDC not ready"
  # shellcheck disable=SC2046
  after=$(counts_diff $(db_names))
  marker_clear reset
  python3 -c 'import json,sys; print(json.dumps({"state":"s0","start_utc":sys.argv[1],"end_utc":sys.argv[2],"duration_s":int(sys.argv[3]),"counts_equal_after_restore":True,"counts_diff_after_start":[l for l in sys.argv[4].split("\n") if l],"repairs":sys.argv[5].split()}, indent=1))' \
    "$(date -u -d "@$t0" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)" "$(now_iso)" "$(( $(date +%s) - t0 ))" "$after" "$REPAIRS" > "$STATE/last-reset.json"
  ok "reset done in $(( $(date +%s) - t0 )) s${REPAIRS:+ (repairs:$REPAIRS)}"
}

diagnostics() {
  [ -s "$KUBECONFIG" ] || return 0
  local d; d="$STATE/diagnostics/$(date -u +%Y%m%d-%H%M%S)"; mkdir -p "$d"
  k get pods -A -o wide > "$d/pods.txt" 2>&1 || true
  k get events -A --sort-by=.lastTimestamp > "$d/events.txt" 2>&1 || true
  helm list -A > "$d/helm.txt" 2>&1 || true
  tail -n 200 "$LOGF" > "$d/reproduce-log-tail.txt" 2>/dev/null || true
  info "diagnostics (pods, events, releases): $(rel "$d")"
}

# ── Phase 0: fetch ────────────────────────────────────────────────────────────────
phase_fetch() {
  set_phase fetch
  if [ -e "$SRC/.git" ]; then
    [ -z "$(git -C "$SRC" status --porcelain)" ] || die "src/ has local changes – not touched:"$'\n'"$(git -C "$SRC" status --short)"
    if q git -C "$SRC" pull --ff-only origin main; then ok "repository updated: $(commit | cut -c1-7)"
    elif [ -f "$BUNDLE/src.bundle" ]; then warn "no network – using src/ as it is ($(commit | cut -c1-7))"
    else die "git pull failed (network?)"; fi
  else
    if ! q git clone "$REPO_URL" "$SRC"; then
      [ -f "$BUNDLE/src.bundle" ] || die "git clone failed (network?)"
      q git clone "$BUNDLE/src.bundle" "$SRC" || die "clone from bundle failed"
    fi
    ok "repository cloned: $(commit | cut -c1-7)"
  fi
  commit > "$STATE/commit"
}

# ── Phase 1: tools and charts ─────────────────────────────────────────────────────
phase_tools() {
  set_phase tools
  [ -e "$SRC/.git" ] || need_fail "repository missing" "./reproduce fetch"
  mkdir -p "$TOOLS" "$STATE/charts"
  local t; t=$(mktemp -d)
  if [ -x "$TOOLS/helm" ] && "$TOOLS/helm" version --short 2>/dev/null | grep -q "^${HELM_VERSION}+"; then skip "helm $HELM_VERSION already there"
  elif [ -x "$BUNDLE/tools/helm" ]; then cp "$BUNDLE/tools/helm" "$TOOLS/helm"; ok "helm from bundle"
  else
    ( cd "$t" && curl -fsSLO "https://get.helm.sh/helm-$HELM_VERSION-linux-amd64.tar.gz" && curl -fsSLO "https://get.helm.sh/helm-$HELM_VERSION-linux-amd64.tar.gz.sha256sum" \
      && sha256sum -c --quiet "helm-$HELM_VERSION-linux-amd64.tar.gz.sha256sum" && tar -xzf "helm-$HELM_VERSION-linux-amd64.tar.gz" ) >>"$LOGF" 2>&1 || die "helm download or checksum failed"
    install -m 755 "$t/linux-amd64/helm" "$TOOLS/helm"; ok "helm $HELM_VERSION (checksum verified)"
  fi
  if [ -x "$TOOLS/kubectl" ] && "$TOOLS/kubectl" version --client 2>/dev/null | grep -q "$KUBECTL_VERSION"; then skip "kubectl $KUBECTL_VERSION already there"
  elif [ -x "$BUNDLE/tools/kubectl" ]; then cp "$BUNDLE/tools/kubectl" "$TOOLS/kubectl"; ok "kubectl from bundle"
  else
    ( cd "$t" && curl -fsSLO "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl" && curl -fsSLO "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl.sha256" \
      && echo "$(cat kubectl.sha256)  kubectl" | sha256sum -c --quiet ) >>"$LOGF" 2>&1 || die "kubectl download or checksum failed"
    install -m 755 "$t/kubectl" "$TOOLS/kubectl"; ok "kubectl $KUBECTL_VERSION (checksum verified)"
  fi
  rm -rf "$t"
  local b _r _n chart repo ver _s url f i=0 n got=0
  n=$(echo "$RELEASES" | wc -l | tr -d ' ')
  while read -r b _r _n chart repo ver _s; do
    i=$((i + 1)); f=$(chart_ref "$b")
    if [ -s "$f" ]; then continue; fi
    progress $((i - 1)) "$n" "downloading chart ${chart##*/} $ver"; got=$((got + 1))
    if [ -s "$BUNDLE/charts/$(basename "$f")" ]; then cp "$BUNDLE/charts/$(basename "$f")" "$f"; continue; fi
    case "$repo" in TX) url="$TX_REPO" ;; GF) url="$GF_REPO" ;; *) url="" ;; esac
    if [ "$chart" = PURIS ]; then
      rm -rf "$STATE/puris-src"
      q git clone -q --depth 1 --branch "$PURIS_TAG" "$PURIS_GIT" "$STATE/puris-src" || die "PURIS chart: git clone failed"
      q helm dependency build "$STATE/puris-src/charts/puris" || die "PURIS chart: dependencies failed"
      q helm package "$STATE/puris-src/charts/puris" -d "$STATE/charts" || die "PURIS chart: package failed"
    elif [ -n "$url" ]; then q helm pull "$chart" --repo "$url" --version "$ver" -d "$STATE/charts" || die "chart $chart $ver not available"
    else q helm pull "$chart" --version "$ver" -d "$STATE/charts" || die "chart $chart $ver not available"; fi
    [ -s "$f" ] || die "chart archive missing after download: $f"
  done <<<"$RELEASES"
  progress_end
  if [ "$got" = 0 ]; then skip "$n Helm charts already there"; else ok "$n Helm charts present ($got downloaded)"; fi
}

# ── Phase 2: check ────────────────────────────────────────────────────────────────
phase_check() {
  set_phase check
  [ -x "$TOOLS/helm" ] && [ -x "$TOOLS/kubectl" ] || need_fail "tools missing" "./reproduce tools"
  local c host steal cfg fp need_cpu need_mem vcpu mem prof="" b line
  step "checking requirements (Ubuntu, amd64, programs, sudo, internet, no other Kubernetes)"
  [ "$(uname -m)" = x86_64 ] || die "architecture $(uname -m) – amd64 (x86_64) required" 3
  grep -qi ubuntu /etc/os-release || die "Ubuntu required" 3
  for c in bash curl git python3 tar gzip openssl sha256sum flock setsid; do command -v "$c" >/dev/null || die "missing program: $c" 3; done
  python3 -c 'import yaml' 2>/dev/null || die "Python module yaml missing – install it with: sudo apt-get install -y python3-yaml" 3
  sudo -n true 2>/dev/null || { info "sudo is needed later in phase install (k3s, swap, automatic updates) – checking access now"; sudo -v; } || die "sudo not available" 3
  for host in github.com get.k3s.io get.helm.sh dl.k8s.io ghcr.io registry-1.docker.io quay.io; do
    curl -s -o /dev/null --max-time 10 "https://$host" || { [ -d "$BUNDLE" ] && warn "$host not reachable (bundle present)" || die "$host not reachable – internet access required" 3; }
  done
  if [ -x /usr/local/bin/k3s ] && [ ! -f $OWNER ]; then die "a k3s installation not created by this script exists – not touched" 3; fi
  if pgrep -x kubelet >/dev/null || pgrep -f 'microk8s|minikube|kind-control-plane' >/dev/null; then die "another Kubernetes is running on this machine" 3; fi
  if ss -ltn 2>/dev/null | awk '{print $4}' | grep -q ':6443$' && [ ! -f $OWNER ]; then die "port 6443 is in use by another program" 3; fi
  ok "requirements met"
  spin "machine scan with a CPU speed test" "10 s" py machine "$STATE/machine.json" "$WORK" > /dev/null
  vcpu=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["vcpu"])' "$STATE/machine.json")
  mem=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["mem_total_gib"])' "$STATE/machine.json")
  ok "machine: $(python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print("%s · %s vCPU · %s GiB · %s · score %s" % (m["cpu_model"], m["vcpu"], m["mem_total_gib"], m["os"], m["cpu_single_core_score"]))' "$STATE/machine.json")"
  [ "$(python3 -c 'import json,sys; print(min(json.load(open(sys.argv[1]))["disk_free_gib"].values()))' "$STATE/machine.json" | cut -d. -f1)" -ge 50 ] || die "at least 50 GB free disk space required" 3
  steal=$(spin "measuring steal time – shows whether the machine is shared and busy" "60 s" py steal 60)
  if python3 -c "import sys; sys.exit(0 if float('$steal') > 0.02 else 1)"; then warn "steal time $steal over 60 s – shared and busy machine, expect waiting or invalid runs"; else ok "steal time $steal over 60 s"; fi
  # calculator (REPRODUCE.md §8)
  step "calculating the resources each profile needs"
  for p in original compact; do
    need_cpu=0; need_mem=0
    for cfg in $(configs_of "$p"); do
      mkdir -p "$STATE/render/$cfg"
      while read -r line; do b=${line%% *}; render "$b" "$cfg" "$STATE/render/$cfg/$b.yaml" || die "rendering $b ($cfg) failed – see log"; done <<<"$RELEASES"
      fp=$(py footprint "$STATE/render/$cfg"/*.yaml)
      echo "$fp" > "$STATE/render/$cfg/footprint.json"
      need_cpu=$(python3 -c "import json,sys; f=json.loads(sys.argv[1]); print(max(float(sys.argv[2]), f['limits_cpu'] + 1))" "$fp" "$need_cpu")
      need_mem=$(python3 -c "import json,sys; f=json.loads(sys.argv[1]); print(max(float(sys.argv[2]), f['limits_mem_gib'] + 3))" "$fp" "$need_mem")
    done
    if python3 -c "import sys; sys.exit(0 if $need_cpu <= $vcpu and $need_mem <= $mem else 1)"; then
      ok "profile $p fits: needs $(printf %.1f "$need_cpu") vCPU / $(printf %.1f "$need_mem") GiB (incl. reserve)"
      [ -n "$prof" ] || prof=$p
    else
      say "·" "profile $p does not fit: needs $(printf %.1f "$need_cpu") vCPU / $(printf %.1f "$need_mem") GiB, machine has $vcpu / $mem"
    fi
  done
  [ -n "$prof" ] || die "machine too small for every profile (minimum: profile compact, see above)" 3
  if [ -f "$STATE/profile" ] && [ "$(profile)" != "$prof" ] && [ -f $OWNER ]; then
    die "profile changed from $(profile) to $prof on an installed cluster – run ./reproduce uninstall first" 3
  fi
  echo "$prof" > "$STATE/profile"
  ok "profile: $prof (configurations: $(configs_of "$prof" | sed 's/ /, /g'))"
  local plans=""
  for cfg in $(configs_of "$prof"); do
    ( load_plan "$(plan_of "$cfg")" ) || exit $?   # stops with the reason (die) – errors in a plan show up now, not after hours
    plans="$plans, $cfg $(tr ',' '\n' <<<"$( load_plan "$(plan_of "$cfg")"; echo "$RATES")" | wc -l) stages"
  done
  ok "measurement plans valid:${plans#,}"
  case "$prof" in
    compact)  info "compact = resource limits of the setup measured in the thesis (fits 8 vCPU)" ;;
    original) info "original = resources as shipped by Tractus-X (needs about 20 vCPU)" ;;
  esac
}

# ── Phase 3: install (sudo) ───────────────────────────────────────────────────────
phase_install() {
  set_phase install
  [ -f "$STATE/profile" ] || need_fail "machine not checked" "./reproduce check"
  if [ -f $OWNER ] && [ "$(/usr/local/bin/k3s --version 2>/dev/null | awk 'NR==1{print $3}')" = "$K3S_VERSION" ] && k get nodes >/dev/null 2>&1; then
    skip "k3s $K3S_VERSION already installed by this script"
  else
    sudo -n true 2>/dev/null || info "sudo password needed: k3s is installed system-wide; swap and automatic updates are switched off (./reproduce uninstall restores them)"
    sudo -v || die "sudo not available"
    step "saving system settings, switching off automatic updates and swap"
    if [ ! -f "$STATE/system-before.json" ]; then
      python3 - "$STATE/system-before.json" <<'EOF'
import json, subprocess, sys
run = lambda *c: subprocess.run(c, capture_output=True, text=True).stdout.strip()
json.dump({"apt-daily.timer": run("systemctl", "is-enabled", "apt-daily.timer"), "apt-daily-upgrade.timer": run("systemctl", "is-enabled", "apt-daily-upgrade.timer"),
           "snap_hold": "hold" in run("snap", "refresh", "--time"), "swap_active": bool(run("swapon", "--show", "--noheadings"))}, open(sys.argv[1], "w"), indent=1)
EOF
    fi
    q sudo systemctl disable --now apt-daily.timer apt-daily-upgrade.timer || true
    command -v snap >/dev/null && { q sudo snap refresh --hold || true; }
    q sudo swapoff -a; [ -f /etc/fstab.reproduce-bak ] || q sudo sed -i.reproduce-bak -E 's|^([^#][^ ]*[[:space:]]+[^ ]+[[:space:]]+swap[[:space:]].*)$|#\1|' /etc/fstab
    q sudo install -D -m 644 "$SRC/setup/a2-k3s/config.yaml" /etc/rancher/k3s/config.yaml
    step "installing k3s $K3S_VERSION"
    if [ -x "$BUNDLE/k3s/k3s" ]; then
      q sudo install -m 755 "$BUNDLE/k3s/k3s" /usr/local/bin/k3s
      q sudo install -D -m 644 "$BUNDLE/k3s/k3s-airgap-images-amd64.tar.zst" /var/lib/rancher/k3s/agent/images/k3s-airgap-images-amd64.tar.zst
      [ ! -f "$BUNDLE/images.tar" ] || q sudo install -D -m 644 "$BUNDLE/images.tar" /var/lib/rancher/k3s/agent/images/reproduce-images.tar
      sudo env INSTALL_K3S_SKIP_DOWNLOAD=true INSTALL_K3S_VERSION="$K3S_VERSION" INSTALL_K3S_EXEC="--disable traefik" sh "$BUNDLE/k3s/install.sh" >>"$LOGF" 2>&1 || die "k3s installation (bundle) failed"
    else
      spin "downloading and starting k3s" "30 s" bash -c 'curl -sfL https://get.k3s.io | sudo env INSTALL_K3S_VERSION="$1" INSTALL_K3S_EXEC="--disable traefik" sh - >>"$2" 2>&1' _ "$K3S_VERSION" "$LOGF" \
        || die "k3s installation failed"
    fi
    printf 'installed by reproduce %s, work folder %s\n' "$(now_iso)" "$WORK" | sudo install -D -m 644 /dev/stdin "$OWNER"
    sudo cat /etc/rancher/k3s/k3s.yaml > "$KUBECONFIG"; chmod 600 "$KUBECONFIG"
    local i; for i in $(seq 60); do [ -n "$(k get node -o name 2>/dev/null)" ] && break; sleep 5; done  # node object appears only after k3s registers it
    q k wait --for=condition=Ready node --all --timeout=300s || die "node not ready"
    ok "k3s $K3S_VERSION installed"
  fi
  sudo -n test -r /etc/rancher/k3s/k3s.yaml 2>/dev/null && sudo cat /etc/rancher/k3s/k3s.yaml > "$KUBECONFIG" 2>/dev/null && chmod 600 "$KUBECONFIG" || true
  local alloc cap
  cap=$(k get node -o jsonpath='{.items[0].status.capacity.cpu}'); alloc=$(k get node -o jsonpath='{.items[0].status.allocatable.cpu}')
  [ "$((cap - 1))" = "$alloc" ] || die "allocatable CPU $alloc ≠ capacity $cap − 1 (system-reserved missing)"
  cat /proc/sys/kernel/random/boot_id > "$STATE/boot_id"
  # images once, one after another, with back-off on rate limits (REPRODUCE.md §22.9)
  local img n=0 total wait_s pulled=0 t0=$SECONDS t1 pid list
  list=$(py images "$STATE/render"/"$(profile)"-k*/*.yaml; printf '%s\n' "grafana/k6:2.2.0@sha256:9bd01d6941fca969cb61bb57d2da5ee9b385fe2aa8881df3798c196564d6ace6" "ghcr.io/grafana/k6-operator:starter-v1.6.0@sha256:b97b8e32867a553b7f866acd1e0a2ac91af81480c04c12a6ee55df3ae99d2ad6")
  total=$(printf '%s\n' "$list" | grep -c .)
  step "pulling $total images (once)"
  sudo -v || die "sudo not available"   # before the loop: a password prompt from a background pull would hang
  while read -r img; do
    n=$((n + 1))
    if sudo k3s crictl inspecti "$img" >/dev/null 2>&1; then progress "$n" "$total" "present: ${img%%@*}"; continue; fi
    wait_s=60
    while :; do
      progress "$((n - 1))" "$total" "pulling ${img%%@*}"
      t1=$SECONDS; sudo k3s crictl pull "$img" >>"$LOGF" 2>&1 & pid=$!
      while kill -0 "$pid" 2>/dev/null; do sleep 1; [ "$TTY" = 1 ] && progress "$((n - 1))" "$total" "pulling ${img%%@*}" "$((SECONDS - t1))"; done
      wait "$pid" && break
      progress_end
      if tail -n 5 "$LOGF" | grep -qiE 'toomanyrequests|429'; then
        [ "$wait_s" -le 1920 ] || die "registry download limit reached – try again later or use a bundle (REPRODUCE.md §22.11)"
        warn "download limit of the registry – waiting $((wait_s / 60)) min ($n/$total)"; sleep "$wait_s"; wait_s=$((wait_s * 2))
      else
        die "image pull failed: $img"
      fi
    done
    pulled=$((pulled + 1))
  done <<< "$list"
  progress_end
  ok "$total images present ($pulled pulled, $((total - pulled)) already there, $(dur $((SECONDS - t0))))"
}

# ── Reboot detection and repair (REPRODUCE.md §22.4) ──────────────────────────────
ensure_boot() {
  [ -f "$STATE/boot_id" ] || return 0
  [ "$(cat /proc/sys/kernel/random/boot_id)" != "$(cat "$STATE/boot_id")" ] || return 0
  warn "reboot detected – repairing before anything else"
  q k wait --for=condition=Ready node --all --timeout=600s || die "node not ready after reboot"
  wait_namespaces 2100 monitoring logging identity customer supplier k6-operator || die "pods not ready after reboot"
  if [ -f "$STATE/s0/SHA256SUMS" ] && [ -n "$(counts_diff c1-wallet)" ]; then
    step "wallet database lost with the reboot – restoring from S0"
    scale identity ssi-dim-wallet-stub 0; wait_gone identity ssi-dim-wallet-stub || die "wallet did not stop"
    db_cmd c1-wallet pg_restore "--clean --if-exists --single-transaction --exit-on-error" < "$STATE/s0/c1-wallet.dump" || die "wallet restore failed"
    scale identity ssi-dim-wallet-stub 1; wait_ready identity ssi-dim-wallet-stub 600 || die "wallet not ready"
    [ -z "$(counts_diff c1-wallet)" ] || die "wallet rows differ from S0 after restore"
    marker_set reset
  fi
  [ ! -f "$STATE/s0/SHA256SUMS" ] || reset_sut
  cat /proc/sys/kernel/random/boot_id > "$STATE/boot_id"
  ok "reboot repaired"
}

# open multi-step changes are completed first (REPRODUCE.md §22.3)
resume_markers() {
  if marker_has run; then
    local d; d=$(marker_get run)
    warn "a run was interrupted: $(basename "$d") – closed as invalid"
    stop_own_load
    [ ! -d "$d" ] || py attempt "$d" interrupted failed "interrupted (stop, crash or reboot)" || true
    marker_clear run
  fi
  if marker_has s0; then rm -rf "$STATE/s0.tmp"; marker_clear s0; fi
  if marker_has apply; then warn "a configuration change was interrupted – applying again"; apply_config "$(marker_get apply)"; fi
  if marker_has reset && [ -f "$STATE/s0/SHA256SUMS" ]; then warn "a reset was interrupted – repeating it"; reset_sut; fi
}

wait_namespaces() {  # timeout ns... → all workloads and pods (except finished ones) ready
  # prints one line per minute with the pods still missing and why; warns once if a pod is stuck
  python3 - "$@" <<'EOF'
import json, os, subprocess, sys, time
to, nss = int(sys.argv[1]), sys.argv[2:]
t0 = time.time(); oom = {}; stuck_since = {}; warned = set(); next_line = 60
COL = os.environ.get("REPRODUCE_COLOR") == "1"
def say(sym, text):
    t = time.strftime("%H:%M:%S", time.gmtime()); line = "%s %s %s" % (t, sym, text)
    if os.environ.get("REPRODUCE_BG") != "1":
        with open(os.environ["LOGF"], "a") as f: f.write(line + "\n")
        if COL: line = "\033[2m%s\033[0m %s%s %s\033[0m" % (t, "\033[2m" if sym == "·" else "\033[33m", sym, text)
    print(line, flush=True)
def mins(s): return "%dm%02ds" % (s // 60, s % 60)
def get(*a):
    r = subprocess.run(["kubectl", "--request-timeout=30s", "get", *a, "-o", "json"], capture_output=True, text=True)
    return json.loads(r.stdout)["items"] if r.returncode == 0 and r.stdout else None
HARD = {"CreateContainerConfigError", "CreateContainerError", "InvalidImageName", "ImagePullBackOff", "ErrImagePull", "RunContainerError"}
def why(p):  # → short reason, stuck?
    st = p.get("status") or {}
    for c in st.get("conditions") or []:
        if c.get("type") == "PodScheduled" and c.get("status") == "False":
            return "not scheduled: " + (c.get("message") or c.get("reason") or "")[:90], True
    cs = (st.get("initContainerStatuses") or []) + (st.get("containerStatuses") or [])
    for c in cs:
        w = (c.get("state") or {}).get("waiting") or {}
        if w.get("reason") in HARD: return "%s – %s" % (w["reason"], (w.get("message") or "")[:100]), True
        if w.get("reason") == "CrashLoopBackOff": return "crashed and restarting (%d×)" % c.get("restartCount", 0), c.get("restartCount", 0) >= 3
    if any(not c.get("ready") for c in st.get("initContainerStatuses") or []): return "initialising", False
    if not st.get("containerStatuses") or any(((c.get("state") or {}).get("waiting") or {}).get("reason") == "ContainerCreating" for c in cs): return "starting", False
    return "started, waiting for its readiness check", False
while True:
    bad = []
    for ns in nss:
        pods, wls = get("pods", "-n", ns), get("deploy,sts,ds", "-n", ns)
        if pods is None or wls is None: bad.append(("Kubernetes API", "not reachable", False)); continue
        for w in wls:  # catches pods that do not exist yet (right after helm)
            s = w.get("status") or {}
            want = s.get("desiredNumberScheduled", 0) if w["kind"] == "DaemonSet" else (w.get("spec") or {}).get("replicas", 1)
            have = s.get("numberReady", 0) if w["kind"] == "DaemonSet" else s.get("readyReplicas", 0)
            if have < want and not any(b[0].startswith(w["metadata"]["name"]) for b in bad): bad.append((w["metadata"]["name"], "%d of %d ready" % (have, want), False))
        for p in pods:
            ph = p["status"].get("phase")
            if ph == "Succeeded" or (ph == "Failed" and any(o.get("kind") == "Job" for o in p["metadata"].get("ownerReferences") or [])): continue
            cs = p["status"].get("containerStatuses") or []
            for c in cs:
                t = (c.get("lastState") or {}).get("terminated") or {}
                if t.get("reason") == "OOMKilled": oom["%s/%s/%s" % (ns, p["metadata"]["name"], c["name"])] = c.get("restartCount", 0)
            if not cs or not all(c.get("ready") for c in cs):
                r, st = why(p); name = p["metadata"]["name"]
                bad = [b for b in bad if not name.startswith(b[0])] + [(name, r, st)]
    el = int(time.time() - t0)
    if not bad: sys.exit(0)
    hard = [k for k, v in oom.items() if v >= 3]
    if hard: say("·", "killed repeatedly for exceeding the RAM limit (OOMKilled): " + ", ".join(hard)); sys.exit(2)
    if el > to: say("·", "not ready after %s: %s" % (mins(el), "; ".join("%s (%s)" % b[:2] for b in bad))); sys.exit(1)
    for name, r, st in bad:
        if not st: stuck_since.pop(name, None); continue
        stuck_since.setdefault(name, el)
        if el - stuck_since[name] >= 180 and name not in warned:
            warned.add(name); say("!", "%s looks stuck: %s – this rarely fixes itself (the step gives up after %d min)" % (name, r, to // 60))
    if el >= next_line:
        next_line += 60
        say("·", "still waiting %s (gives up after %d min) – not ready: %s" % (mins(el), to // 60,
            ", ".join("%s (%s)" % (n, r if len(r) <= 48 else r[:47] + "…") for n, r, _ in bad[:3]) + (" and %d more" % (len(bad) - 3) if len(bad) > 3 else "")))
    time.sleep(10)
EOF
}

# ── Phase 4: deploy ───────────────────────────────────────────────────────────────
deploy_release() {  # block configuration [prefix]
  local b="$1" cfg="$2" pre="${3:-}" rel ns args=() f h
  rel=$(release_line "$b" | awk '{print $2}'); ns=$(release_line "$b" | awk '{print $3}')
  h=$(desired_hash "$b" "$cfg")
  if [ "$(cat "$STATE/releases/$ns-$rel" 2>/dev/null)" = "$h" ] && helm status "$rel" -n "$ns" >/dev/null 2>&1; then skip "${pre}$b already installed ($cfg)"; return 0; fi
  step "${pre}installing $b ($cfg)"
  while IFS= read -r f; do args+=(-f "$f"); done < <(values_files "$b" "$cfg")
  q helm upgrade --install "$rel" "$(chart_ref "$b")" -n "$ns" --create-namespace --timeout 60m "${args[@]}" || die "helm install of $b failed – see log"
  mkdir -p "$STATE/releases"; echo "$h" > "$STATE/releases/$ns-$rel"
  ok "${pre}$b installed ($cfg)"
}
phase_deploy() {
  set_phase deploy
  [ -f $OWNER ] && k get nodes >/dev/null 2>&1 || need_fail "k3s not installed" "./reproduce install"
  ensure_boot
  local cfg ns d line b rc i=0 n to t1
  n=$(echo "$RELEASES" | wc -l | tr -d ' ')
  cfg="$(profile)-k0"
  [ -f "$STATE/config" ] && cfg=$(cat "$STATE/config")
  for ns in monitoring logging identity customer supplier k6-operator k6; do k create namespace "$ns" --dry-run=client -o yaml | q k apply -f -; done
  for ns in customer supplier; do
    d="$STATE/keys/$ns"; mkdir -p "$d"
    [ -f "$d/tokenSignerPrivateKey" ] || openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$d/tokenSignerPrivateKey" 2>/dev/null
    [ -f "$d/tokenSignerPublicKey" ] || openssl pkey -in "$d/tokenSignerPrivateKey" -pubout -out "$d/tokenSignerPublicKey"
    for f in client-secret aesKey tokenEncryptionAesKey; do [ -f "$d/$f" ] || openssl rand -base64 32 | tr -d '\n' > "$d/$f"; done
    k create secret generic edc-vault-secrets -n "$ns" --from-file="$d/client-secret" --from-file="$d/aesKey" --from-file="$d/tokenEncryptionAesKey" \
      --from-file="$d/tokenSignerPrivateKey" --from-file="$d/tokenSignerPublicKey" --dry-run=client -o yaml | q k apply -f -
  done
  k create secret generic puris-api-key -n k6 --from-literal=key="$TEST_API_KEY" --dry-run=client -o yaml | q k apply -f -
  # Grafana login (values.yaml: existingSecret grafana-admin); random, stays in state/keys (AUFBAU.md, b1)
  d="$STATE/keys/grafana"; mkdir -p "$d"
  [ -f "$d/admin-password" ] || { openssl rand -base64 18 | tr -d '\n' > "$d/admin-password"; chmod 600 "$d/admin-password"; }
  k create secret generic grafana-admin -n monitoring --from-literal=admin-user=admin --from-file=admin-password="$d/admin-password" \
    --dry-run=client -o yaml | q k apply -f -
  while read -r line; do
    b=${line%% *}; ns=$(echo "$line" | awk '{print $3}')
    i=$((i + 1))
    deploy_release "$b" "$cfg" "[$i/$n] "
    to=$( [ "${b:0:1}" = c ] && echo 2100 || echo 900 ); t1=$SECONDS
    case "$b" in c3-*|c5-*) step "[$i/$n] waiting until $b is ready – a DTR starting with little CPU can take up to 20 min" ;; *) step "[$i/$n] waiting until $b is ready" ;; esac
    rc=0; wait_namespaces "$to" "$ns" 2>>"$LOGF" || rc=$?
    if [ "$rc" = 2 ]; then die "$b: container killed repeatedly for exceeding its RAM limit (OOMKilled) – configuration $cfg as shipped is not runnable on its own; this is a result (REPRODUCE.md §7.4)"; fi
    [ "$rc" = 0 ] || die "$b: pods not ready within $((to / 60)) min – see the reasons above and the diagnostics"
    ok "[$i/$n] $b ready ($(dur $((SECONDS - t1))))"
  done <<<"$RELEASES"
  echo "$cfg" > "$STATE/config"
  ok "all components deployed ($cfg)"
}

# ── Phase 5: prepare ──────────────────────────────────────────────────────────────
phase_prepare() {
  set_phase prepare
  [ -f "$STATE/config" ] || need_fail "components not deployed" "./reproduce deploy"
  ensure_boot; resume_markers
  if [ -f "$STATE/s0/SHA256SUMS" ] && ( cd "$STATE/s0" && sha256sum -c --quiet SHA256SUMS ) 2>/dev/null; then skip "database state S0 already saved"; return 0; fi
  step "test data: supplier"; py testdata supplier "$SRC" "$TEST_API_KEY" >>"$LOGF" 2>&1 || die "test data (supplier) failed – see log"
  step "test data: customer"; py testdata customer "$SRC" "$TEST_API_KEY" >>"$LOGF" 2>&1 || die "test data (customer) failed – see log"
  ok "test data: 20 materials in both companies"
  step "first transaction per material (contracts are negotiated once)"
  local m t0 okn=0 total=0
  t0=$(now_iso)
  for m in $(grep -v '^#' "$SRC/setup/e1-testdaten/materialien.tsv" | tail -n +2 | cut -f2); do
    total=$((total + 1)); [ "$(py trigger "$TEST_API_KEY" "$m" 2>>"$LOGF")" = 200 ] || die "trigger for $m failed"
    if [ "$total" = 1 ]; then   # first one alone: the item-stock contract is negotiated exactly once
      for _ in $(seq 1 36); do k logs -n customer deploy/puris-backend --since-time="$t0" 2>/dev/null | grep -q "Updated ReportedMaterialItemStocks for $m and" && break; sleep 5; done
    else sleep 3; fi
  done
  for _ in $(seq 1 60); do
    okn=$(k logs -n customer deploy/puris-backend --since-time="$t0" 2>/dev/null | grep -c "Updated ReportedMaterialItemStocks" || true)
    [ "$okn" -ge "$total" ] && break; sleep 5
  done
  [ "$okn" -ge "$total" ] || die "only $okn of $total first transactions completed"
  ok "$total first transactions completed"
  step "saving S0 (7 databases)"
  marker_set s0; rm -rf "$STATE/s0.tmp"; mkdir -p "$STATE/s0.tmp"
  stop_sut || die "PURIS/EDC did not stop"
  for n in $(db_names); do
    db_cmd "$n" pg_dump "-Fc" > "$STATE/s0.tmp/$n.dump" || die "pg_dump failed: $n"
    db_counts "$n" > "$STATE/s0.tmp/$n.rows.txt"; [ -s "$STATE/s0.tmp/$n.rows.txt" ] || die "row count failed: $n"
  done
  ( cd "$STATE/s0.tmp" && sha256sum ./*.dump ./*.rows.txt > SHA256SUMS ) || die "checksums failed"
  rm -rf "$STATE/s0"; mv "$STATE/s0.tmp" "$STATE/s0"; marker_clear s0
  for n in $RESET_DBS; do db_cmd "$n" psql "-v ON_ERROR_STOP=1 -q -c 'SET client_min_messages TO error; ANALYZE'" >/dev/null; done
  dp_clear customer; dp_clear supplier
  start_sut || die "PURIS/EDC not ready after S0"
  ok "S0 saved"
}

# ── Phase 6: verify ───────────────────────────────────────────────────────────────
phase_verify() {
  set_phase verify
  [ -f "$STATE/s0/SHA256SUMS" ] || need_fail "S0 missing" "./reproduce prepare"
  ensure_boot; resume_markers
  local cfg b ns out line diffs
  cfg=$(cat "$STATE/config")
  while read -r line; do
    b=${line%% *}; ns=$(echo "$line" | awk '{print $3}')
    render "$b" "$cfg" "$STATE/render/current-$b.yaml" || die "rendering $b failed"
    out=$(py conformance "$ns" "$STATE/render/current-$b.yaml" 2>&1) || die "running $b differs from configuration $cfg:"$'\n'"$out"
  done <<<"$RELEASES"
  ok "conformance: running resources = configuration $cfg"
  wait_namespaces 600 monitoring logging identity customer supplier k6-operator 2>>"$LOGF" || die "not all pods ready within 10 min"
  diffs=$(counts_diff c1-wallet c3-customer-dtr c5-supplier-dtr); [ -z "$diffs" ] || die "wallet/DTR rows differ from S0: $diffs"
  function_test 1 || die "test transaction failed: $FT_JSON"
  cat /proc/sys/kernel/random/boot_id > "$STATE/boot_id"; now_iso > "$STATE/verified"
  ok "verified (pods ready, wallet/DTR = S0, test transaction ok)"
}

# ── Phase 7: measure ──────────────────────────────────────────────────────────────
apply_config() {  # configuration
  local cfg="$1" line b changed=""
  [ "$(cat "$STATE/config" 2>/dev/null)" = "$cfg" ] && ! marker_has apply && return 0
  marker_set apply "$cfg"
  step "applying configuration $cfg"
  stop_sut || die "PURIS/EDC did not stop"
  while read -r line; do
    b=${line%% *}
    if [ "$(cat "$STATE/releases/$(echo "$line" | awk '{print $3"-"$2}')" 2>/dev/null)" != "$(desired_hash "$b" "$cfg")" ]; then deploy_release "$b" "$cfg"; changed="$changed $b"; fi
  done <<<"$RELEASES"
  for b in $SUT_NS; do for a in $SUT_APPS; do scale "$b" "$a" 0; done; done
  for b in $SUT_NS; do q k rollout status sts -n "$b" --timeout=900s || die "databases in $b not ready after the configuration change"; done
  echo "$cfg" > "$STATE/config"
  reset_sut
  marker_clear apply
  ok "configuration $cfg applied (changed:${changed:- none})"
}
results_dir() {  # current results folder for this profile, commit and mode – short tests never share a folder with real runs
  local d f mode
  f="$STATE/results-current"; mode=$( [ "${REPRODUCE_SMOKE:-0}" = 1 ] && echo short || echo full)
  if [ -f "$f" ] && d=$(cat "$f") && [ -d "$d" ] && [ "$(cat "$d/.commit" 2>/dev/null)" = "$(commit)" ] && [ "$(cat "$d/.profile" 2>/dev/null)" = "$(profile)" ] \
     && [ "$(cat "$d/.mode" 2>/dev/null)" = "$mode" ] && [ "$(cat "$d/.reps" 2>/dev/null)" = "$REPS" ]; then echo "$d"; return; fi
  d="$RESULTS/$(date -u +%Y-%m-%d_%H%M)_$(profile)$( [ "$mode" = short ] && echo _short)"; mkdir -p "$d"
  commit > "$d/.commit"; profile > "$d/.profile"; echo "$mode" > "$d/.mode"; echo "$REPS" > "$d/.reps"
  cp "$STATE/machine.json" "$d/machine.json"; echo "$d" > "$f"; echo "$d"
}
count_runs() {  # results-dir configuration → "valid invalid"
  python3 - "$1" "$2" <<'EOF'
import json, os, sys
v = i = 0
for d in os.listdir(sys.argv[1]):
    if "_%s_rep-" % sys.argv[2] not in d or not os.path.isdir(os.path.join(sys.argv[1], d)): continue
    p = os.path.join(sys.argv[1], d, "meta.json")
    if os.path.isfile(p) and json.load(open(p)).get("validity", {}).get("valid"): v += 1
    else: i += 1
print(v, i)
EOF
}
run_counts() {  # results-dir configuration → "valid invalid running" for display; the run in progress is not invalid
  local v i r=0 cur
  read -r v i <<<"$(count_runs "$1" "$2")"
  if marker_has run; then
    cur=$(marker_get run)
    if [ "$(dirname "$cur")" = "$1" ] && [[ $(basename "$cur") == *"_$2_rep-"* ]] && [ ! -f "$cur/meta.json" ]; then i=$((i > 0 ? i - 1 : 0)); r=1; fi
  fi
  echo "$v $i $r"
}
gates() {  # disk and noise before a run (REPRODUCE.md §22.7, §22.10)
  local free i steal
  free=$(df -P -BG /var/lib/rancher "$WORK" | awk 'NR>1 {gsub("G","",$4); print $4}' | sort -n | head -1)
  [ "$free" -ge 20 ] || die "only $free GB free disk space – at least 20 GB needed before a run"
  if [ -f "$STATE/last_run_used_gb" ] && [ "$free" -lt $(( 3 * $(cat "$STATE/last_run_used_gb") )) ]; then die "free disk ($free GB) below 3 × the space of the last run"; fi
  for i in $(seq 1 31); do
    steal=$(py prom 'sum(rate(node_cpu_seconds_total{mode="steal"}[2m]))/sum(rate(node_cpu_seconds_total[2m]))' 2>/dev/null || echo "")
    [ -n "$steal" ] && python3 -c "import sys; sys.exit(0 if float('$steal') < 0.01 else 1)" && return 0
    [ "$i" -lt 31 ] || { warn "machine still busy (steal ${steal:-?}) after 60 min – starting anyway"; return 0; }
    [ "$i" -gt 1 ] || warn "machine busy (steal ${steal:-?} ≥ 1 %) – waiting for a quiet machine (up to 60 min)"
    sleep 120
  done
}
start_load() {  # name testid → applies TestRun from the plan environment
  k create configmap k6-stock-trigger -n k6 --from-file=stock-trigger.js="$SRC/experiments/k6/stock-trigger.js" --dry-run=client -o yaml | q k apply -f -
  py render-testrun "$1" "$2" "$SRC/setup/e1-testdaten/materialien.tsv" > "$TMPD/testrun.json"
  q k delete testrun -n k6 -l reproduce=1 --wait=true --timeout=120s
  q k create -f "$TMPD/testrun.json" || die "TestRun could not be created"
}
watch_load() {  # name t_apply labels minutes rates → 0 finished, 1 stalled (rates only for the stage lines)
  local rc msg last="" free
  while true; do
    rc=0; msg=$(py watchdog "$1" "$2" "$3" "$4" 2>&1) || rc=$?
    case "$rc" in
      0) return 0 ;;
      10) local key="${msg%% · *}"
          if [ "$key" != "$last" ]; then
            if [[ $key =~ ^stage\ ([^ ]+)\ \(([0-9]+)/([0-9]+)\)$ ]]; then
              step "load stage ${BASH_REMATCH[1]} · ${BASH_REMATCH[2]} of ${BASH_REMATCH[3]} · $(echo "${5:-$RATES}" | cut -d, -f"${BASH_REMATCH[2]}") transactions/s · $4 min"
            else info "$msg"; fi
            last="$key"
          fi ;;
      *) fail "load generator stalled: $msg"; return 1 ;;
    esac
    free=$(df -P -BG /var/lib/rancher "$WORK" | awk 'NR>1 {gsub("G","",$4); print $4}' | sort -n | head -1)
    [ "$free" -ge 5 ] || { fail "less than 5 GB free disk space during the run"; return 1; }
    sleep 30
  done
}
PLAN_KEYS="PLAN_KIND RATES STAGE_LABELS STAGE_DURATION MATERIALS_N DRAIN_MAX_MIN STEAL_MAX STEAL_MEAN_MAX"
PLAN_IGNORED="STATE"   # names a database state of lab; reproduce always resets to its own S0
readonly PLAN_KEYS PLAN_IGNORED
load_plan() {  # plan → exports the plan's values; the file is read as data (KEY="value" lines) and never executed
  local pf="$SRC/experiments/plans/$1.env" line k v n
  [ -r "$pf" ] || die "plan file missing: experiments/plans/$1.env"
  for k in $PLAN_KEYS; do unset "$k"; done
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $line =~ ^([A-Z_][A-Z0-9_]*)=\"([^\"\$\`\\]*)\"[[:space:]]*(#.*)?$ ]] || die "plan $1, line $n: not of the form KEY=\"value\": $line"
    k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
    case " $PLAN_KEYS " in *" $k "*) export "$k=$v"; continue ;; esac
    case " $PLAN_IGNORED " in *" $k "*) continue ;; esac
    die "plan $1, line $n: unknown key $k – known: ${PLAN_KEYS// /, }"
  done < "$pf"
  for k in RATES STAGE_LABELS STAGE_DURATION; do [ -n "${!k:-}" ] || die "plan $1: $k missing"; done
  [[ $STAGE_DURATION =~ ^[0-9]+$ ]] || die "plan $1: STAGE_DURATION must be whole minutes, is $STAGE_DURATION"
  [ "$(tr ',' '\n' <<<"$RATES" | wc -l)" = "$(tr ',' '\n' <<<"$STAGE_LABELS" | wc -l)" ] \
    || die "plan $1: RATES has $(tr ',' '\n' <<<"$RATES" | wc -l) stages, STAGE_LABELS $(tr ',' '\n' <<<"$STAGE_LABELS" | wc -l)"
  export PLAN="$1" PLAN_STATE="s0"
  if [ "${REPRODUCE_SMOKE:-0}" = 1 ]; then export STAGE_DURATION=2 PLAN_KIND=smoke; fi
}
log_probe() {  # configuration results-dir
  local cfg="$1" rd="$2" name t_apply max
  [ -f "$rd/probe-$cfg.json" ] && grep -q '"ok": true' "$rd/probe-$cfg.json" && { skip "log capacity probe ($cfg) passed before"; return 0; }
  max=$(echo "$RATES" | tr ',' '\n' | sort -g | tail -1)
  step "log capacity probe: 3 min at $max/s"
  reset_sut
  name="probe-$(date -u +%Y%m%d%H%M%S)"
  ( export RATES="$max" STAGE_LABELS="probe" STAGE_DURATION=3; start_load "$name" "$name" )
  t_apply=$(now_iso)
  watch_load "$name" "$t_apply" probe 3 "$max" || { stop_own_load; die "probe: load generator stalled"; }
  if py probe "$name" "$t_apply" > "$rd/probe-$cfg.json"; then ok "log capacity probe passed: $(cat "$rd/probe-$cfg.json")"
  else die "log capacity probe failed – monitoring cannot keep up at $max/s: $(cat "$rd/probe-$cfg.json")"; fi
}
one_run() {  # configuration rep results-dir
  local cfg="$1" rep="$2" rd="$3" run name t_apply used0 used1 valid
  run="$rd/$(date -u +%Y-%m-%d_%H%M)_${cfg}_rep-$rep"
  mkdir "$run" || die "run folder exists: $run"
  marker_set run "$run"
  export ATTEMPT_COMMIT; ATTEMPT_COMMIT=$(commit); export ATTEMPT_PLAN="$PLAN" ATTEMPT_REP="$rep" REP="$rep"
  py attempt "$run" created running ""
  used0=$(df -P -BG /var/lib/rancher | awk 'NR==2 {gsub("G","",$3); print $3}')
  gates
  py attempt "$run" reset running ""
  reset_sut
  function_test 3 || { py attempt "$run" function_test failed "function test failed: $FT_JSON"; marker_clear run; warn "function test failed after reset – run invalid"; return 1; }
  python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); r["function_test"]=json.loads(sys.argv[2]); print(json.dumps(r, indent=1))' "$STATE/last-reset.json" "$FT_JSON" > "$TMPD/reset.json"
  cp "$TMPD/reset.json" "$run/reset.json"
  name=$(echo "rp-$(date -u +%Y%m%d%H%M%S)-$rep" | tr 'A-Z_' 'a-z-')
  py attempt "$run" load running ""
  start_load "$name" "$(basename "$run")"; t_apply=$(now_iso); cp "$TMPD/testrun.json" "$run/testrun.json"
  ok "load started: $(basename "$run") ($(echo "$RATES" | tr ',' '\n' | wc -l | tr -d ' ') stages × $STAGE_DURATION min)"
  if ! watch_load "$name" "$t_apply" "$STAGE_LABELS" "$STAGE_DURATION" "$RATES"; then stop_own_load; py attempt "$run" load failed "load generator stalled"; marker_clear run; return 1; fi
  py attempt "$run" collecting running ""
  step "collecting (drain, Prometheus, Loki, EDC)"
  py collect "$run" "$name" "$(basename "$run")" "$t_apply" "$(commit)" "$TMPD" "$STATE/machine.json" "$(profile)" "$cfg" "$(cp_limit_of "$cfg")" >>"$LOGF" 2>&1 \
    || { py attempt "$run" collecting failed "collection failed – see reproduce.log"; marker_clear run; warn "collection failed – run invalid"; return 1; }
  mkdir -p "$run/db"; for n in $(db_names); do db_counts "$n" > "$run/db/$n.zeilen-nach-lauf.txt"; done
  ( cd "$run" && find . -type f ! -name SHA256SUMS | LC_ALL=C sort | xargs sha256sum > SHA256SUMS )
  valid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["validity"]["valid"])' "$run/meta.json")
  py attempt "$run" completed completed "valid=$valid"
  marker_clear run
  used1=$(df -P -BG /var/lib/rancher | awk 'NR==2 {gsub("G","",$3); print $3}'); echo $(( used1 > used0 ? used1 - used0 : 1 )) > "$STATE/last_run_used_gb"
  if [ "$valid" = True ]; then ok "run valid: $(basename "$run")"; else warn "run invalid: $(basename "$run") – $(python3 -c 'import json,sys; v=json.load(open(sys.argv[1]))["validity"]; print(", ".join(k for k,x in v.items() if k.endswith("_ok") and x is not True))' "$run/meta.json")"; return 1; fi
}
phase_measure() {
  set_phase measure
  [ -f "$STATE/s0/SHA256SUMS" ] || need_fail "S0 missing" "./reproduce prepare"
  local want="${1:-}" cfgs cfg rd v i rep
  cfgs=$(configs_of "$(profile)")
  if [ -n "$want" ]; then echo " $cfgs " | grep -q " $want " || die "configuration $want does not belong to profile $(profile) ($cfgs)" 2; cfgs="$want"; fi
  TMPD=$(mktemp -d)
  [ "${REPRODUCE_SMOKE:-0}" != 1 ] || warn "short test mode (REPRODUCE_SMOKE=1): stages of 2 min – these runs are not valid for the thesis"
  rd=$(results_dir)
  for cfg in $cfgs; do
    set_phase "measure:$cfg"
    ensure_boot; resume_markers
    apply_config "$cfg"
    phase_verify
    load_plan "$(plan_of "$cfg")"
    log_probe "$cfg" "$rd"
    read -r v i <<<"$(count_runs "$rd" "$cfg")"
    while [ "$v" -lt "$REPS" ] && [ "$i" -le "$MAX_REPLACEMENTS" ]; do
      rep=$((v + i + 1))
      say "▶" "$cfg: run $rep (valid so far $v of $REPS, invalid $i)"
      one_run "$cfg" "$rep" "$rd" || true
      read -r v i <<<"$(count_runs "$rd" "$cfg")"
      eta_info
    done
    if [ "$v" -ge "$REPS" ]; then ok "$cfg: $v valid runs"; else warn "$cfg: only $v valid runs after $MAX_REPLACEMENTS replacement runs – reported as failed"; fi
  done
  rm -rf "$TMPD"
}

# ── Phases 8 and 9: evaluate, package ─────────────────────────────────────────────
phase_evaluate() {
  set_phase evaluate
  local rd="${1:-$(cat "$STATE/results-current" 2>/dev/null)}"
  [ -n "$rd" ] && [ -d "$rd" ] || need_fail "no results folder" "./reproduce measure"
  ls -d "$rd"/*_rep-* >/dev/null 2>&1 || need_fail "no runs in $(rel "$rd") yet" "./reproduce measure"
  py evaluate "$rd" "$SRC/reference"
  ok "evaluation: $rd/verdict.md"
}
phase_package() {
  set_phase package
  local rd="${1:-$(cat "$STATE/results-current" 2>/dev/null)}"
  [ -f "$rd/summary.json" ] || need_fail "not evaluated" "./reproduce evaluate"
  ( cd "$rd" && find . -type f ! -name SHA256SUMS ! -name '.commit' ! -name '.profile' | LC_ALL=C sort | xargs sha256sum > SHA256SUMS )
  ok "results complete: $rd ($(du -sh "$rd" | cut -f1))"
  echo "  copy the run folders into runs/ of the repository, e.g.: cp -r \"$rd\"/*_rep-* <repository>/runs/"
}

# ── snapshot, settings, logs, help ────────────────────────────────────────────────
cmd_snapshot() {  # machine-readable state: ./reproduce status --json; read by the dashboard
  local p rd x st ph="" m xm t c v i r
  p=$(profile); ! job_alive || ph=$(job_field phase); ph=${ph%%:*}
  read -r m xm t <<<"$(eta_minutes)"
  rd=$(cat "$STATE/results-current" 2>/dev/null || true)
  {
    printf 'work\t%s\ncommit\t%s\nprofile\t%s\ndeployed\t%s\nreps\t%s\nmode\t%s\n' "$WORK" "$(commit 2>/dev/null | cut -c1-7 || true)" "$p" \
      "$(cat "$STATE/config" 2>/dev/null || true)" "$(eff_reps)" "$(is_short && echo short || echo full)"
    [ -z "$p" ] || printf 'configs\t%s\n' "$(configs_of "$p")"
    for x in $PHASES; do
      if [ "$x" = "$ph" ]; then st=running; elif phase_state "$x"; then st=done; else st=open; fi
      printf 'phase\t%s\t%s\t%s\t%s\t%s\n' "$x" "$st" "$(phase_desc "$x")" "$(phase_time "$x")" "$(in_background "$x" && echo 1 || echo 0)"
    done
    ! job_alive || printf 'job\t%s\n' "$(cat "$STATE/job")"
    printf 'eta\t%s\t%s\t%s\n' "$m" "$xm" "$t"
    if [ -n "$rd" ] && [ -d "$rd" ] && [ -n "$p" ]; then
      printf 'results\t%s\n' "$rd"
      for c in $(configs_of "$p"); do read -r v i r <<<"$(run_counts "$rd" "$c")"; printf 'runs\t%s\t%s\t%s\t%s\n' "$c" "$v" "$i" "$r"; done
    fi
    printf 'interrupted\t%s\nlog\t%s\nkubeconfig\t%s\n' "$(ls "$MARKERS" 2>/dev/null | tr '\n' ' ')" "$LOGF" "$KUBECONFIG"
  } | py snapshot
}

cmd_dashboard() {  # [--once] → full-screen live view; one frame as text without a terminal
