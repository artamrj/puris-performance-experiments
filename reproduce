    GLYPH = {"ok": ("●", "ok"), "wait": ("◐", "warn"), "bad": ("✗", "err"), "done": ("✓", "d")}

    def meter(c, y, x, width, label, pct, txt):
        bw = max(6, min(20, width - 28)); f = int(round(bw * min(pct, 100) / 100))
        sty = "err" if pct >= 90 else ("warn" if pct >= 75 else "acc")
        c.put(y, x, label.ljust(12), ""); c.put(y, x + 12, "━" * f, sty); c.put(y, x + 12 + f, "─" * (bw - f), "d")
        c.put(y, x + 13 + bw, "%3d %%  %s" % (pct, txt), "d"); return y + 1
    def draw_phases(c, y, x, width, phases, k):
