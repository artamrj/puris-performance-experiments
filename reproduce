def cmd_collect(run, name, testid, t_apply, commit, extra, machine_json, profile, configuration, cp_limit):
    E = os.environ
    RATES = [float(r) for r in E["RATES"].split(",")]; STAGE_MIN = float(E["STAGE_DURATION"])
    LABELS = E["STAGE_LABELS"].split(",") if E.get("STAGE_LABELS") else ["s%d" % (i + 1) for i in range(len(RATES))]
    DRAIN_MAX = float(E.get("DRAIN_MAX_MIN", "15")); STEAL_MAX = float(E.get("STEAL_MAX", "0.05")); STEAL_MEAN_MAX = float(E.get("STEAL_MEAN_MAX", "0.02"))
    SUT_NS = {"customer", "supplier", "identity"}
    for d in ("prometheus", "loki", "edc", "cluster/logs"): os.makedirs(os.path.join(run, d), exist_ok=True)
    pod = runner_pod(name); rstat = pod["status"]["containerStatuses"][0]
    r_start = parse(rstat["state"]["terminated"]["startedAt"]); r_end = parse(rstat["state"]["terminated"]["finishedAt"])
    rlog = kubectl("logs", "-n", "k6", pod["metadata"]["name"])
    open(os.path.join(run, "cluster/logs/k6-runner.txt"), "w").write(rlog)
    summary = json.loads(next(l for l in rlog.splitlines() if "K6_SUMMARY_JSON " in l).split("K6_SUMMARY_JSON ", 1)[1])
    wjson(os.path.join(run, "k6-summary.json"), summary)
    k6s = stage_markers(rlog)
    if set(k6s) != set(LABELS): raise ValueError("k6 stage markers missing (expected %s, found %s)" % (LABELS, sorted(k6s)))
    STAGE_MS = STAGE_MIN * 60000; t0 = k6s[LABELS[0]]
    for i, l in enumerate(LABELS):
        if abs(k6s[l] - t0 - i * STAGE_MS) > 2000: raise ValueError("start of %s differs by more than 2 s from the plan" % l)
    wjson(os.path.join(run, "k6-stages.json"), {l: {"start_ms": k6s[l], "start_utc": iso(datetime.fromtimestamp(k6s[l] / 1000, timezone.utc)), "duration_ms_plan": STAGE_MS} for l in LABELS})
    first = w_start = datetime.fromtimestamp(t0 / 1000, timezone.utc)
    CUST = SEL["customer_puris"]; drain_t0, last, same = datetime.now(timezone.utc), None, 0
    while True:
        trig_n = loki_count(CUST, PAT["triggered"], w_start)
        fin_n = loki_count(CUST, PAT["completed"], w_start) + loki_count(CUST, PAT["failed"], w_start)
        waited = (datetime.now(timezone.utc) - drain_t0).total_seconds() / 60
        if fin_n >= trig_n: reason = "all transactions finished"; break
        same = same + 1 if (trig_n, fin_n) == last else 0; last = (trig_n, fin_n)
        if same >= 4: reason = "no progress for 2 min"; break
        if waited >= DRAIN_MAX: reason = "maximum of %g min reached" % DRAIN_MAX; break
        log("drain: %d of %d open (%.1f min)" % (trig_n - fin_n, trig_n, waited)); time.sleep(30)
    drain_end = datetime.now(timezone.utc); w_end = drain_end + timedelta(minutes=1)
    log("drain: %s; open %d" % (reason, trig_n - fin_n)); time.sleep(75)
    def prom_range(fname, q, step="15s"):
        qs = urllib.parse.urlencode({"query": q, "start": iso(w_start), "end": iso(w_end), "step": step})
        res = json.loads(kraw("%s/api/v1/query_range?%s" % (PROM, qs)))["data"]["result"]
        keys = sorted({k for r in res for k in r["metric"]})
        with open(os.path.join(run, "prometheus", fname + ".csv"), "w", newline="") as f:
            w = csv.writer(f, lineterminator="\n"); w.writerow(["timestamp_utc", *keys, "value"])
            for r in res:
                for t, v in r["values"]: w.writerow([iso(datetime.fromtimestamp(t, timezone.utc)), *[r["metric"].get(k, "") for k in keys], v])
        return res
    C = 'container!="",container!="POD"'; T = 'testid="%s"' % testid
