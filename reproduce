            st = p_["state"]; sym, sty = {"done": ("✓", "ok"), "running": (SPIN[k % 10], "acc"), "open": ("○", "d")}[st]
            c.put(y, x, sym, sty); c.put(y, x + 2, str(i), "d")
            c.put(y, x + 4, p_["name"], "acc b" if st == "running" else ("" if st == "done" else "d"))
            c.put(y, x + 14, cut(p_["purpose"], width - 14), "d"); y += 1
