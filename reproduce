                curses.init_pair(i, col, bg); P[name] = curses.color_pair(i)
        def attr(st):
            a = 0
            for t in st.split():
                a |= {"b": curses.A_BOLD, "d": curses.A_DIM}.get(t, 0) | P.get(t, 0)
                if t == "err": a |= curses.A_BOLD
            return a
