COMPONENTS="puris-customer customer deploy/puris-backend PURIS backend of the customer
puris-supplier supplier deploy/puris-backend PURIS backend of the supplier
edc-customer customer deploy/edc-controlplane EDC control plane of the customer
edc-supplier supplier deploy/edc-controlplane EDC control plane of the supplier
dataplane-customer customer deploy/edc-dataplane EDC data plane of the customer
dataplane-supplier supplier deploy/edc-dataplane EDC data plane of the supplier
dtr-customer customer deploy/dtr digital twin registry of the customer
dtr-supplier supplier deploy/dtr digital twin registry of the supplier
wallet identity deploy/ssi-dim-wallet-stub identity wallet (stub)
loki logging sts/loki log store
alloy logging ds/alloy log collector
prometheus monitoring sts/prometheus-monitoring-kube-prometheus-prometheus metrics store
grafana monitoring deploy/monitoring-grafana dashboards
k6-operator k6-operator deploy/k6-operator-controller-manager operator of the load generator"
cmd_logs() {  # [component] [-f] [--tail n]
  local name="" follow="" tail=100 line ns ref refs="" st n
  while [ $# -gt 0 ]; do case "$1" in -f|--follow) follow=1 ;; --tail) tail="${2:-100}"; shift ;; *) name="$1" ;; esac; shift; done
  if [ -z "$name" ]; then
    printf '%s\n' "${C_B}components${C_0}  ${C_DIM}./reproduce logs <component> [-f] [--tail n]${C_0}"
    while read -r n ns ref _; do refs="$refs $ns/${ref%%/*}/${ref#*/}"; done <<<"$COMPONENTS"
    # shellcheck disable=SC2086
    st=$( [ -s "$KUBECONFIG" ] && py ready $refs 2>/dev/null || true)
    paste <(echo "$COMPONENTS") <(echo "${st:-}") | while IFS=$'\t' read -r line n; do
      read -r name ns ref desc <<<"$line"
      printf "  %-20s %-7s %s\n" "$name" "${n:-–}" "${C_DIM}$desc${C_0}"
    done
    printf "  %-20s %-7s %s\n" reproduce "" "${C_DIM}this script's own log ($(rel "$LOGF"))${C_0}"
    return 0
  fi
  if [ "$name" = reproduce ]; then
    if [ -n "$follow" ]; then exec tail -n "$tail" -F "$LOGF"; else tail -n "$tail" "$LOGF"; fi; return 0
  fi
  line=$(echo "$COMPONENTS" | awk -v n="$name" '$1 == n')
  if [ -z "$line" ]; then
    tell "✗" "unknown component: $name"
    n=$(py closest "$name" $(echo "$COMPONENTS" | awk '{print $1}') reproduce); [ -z "$n" ] || tell "→" "did you mean: ./reproduce logs $n"
    tell "→" "all components: ./reproduce logs"; exit 2
  fi
  [ -s "$KUBECONFIG" ] || { tell "✗" "no cluster of this script yet"; tell "→" "run first: ./reproduce install"; exit 2; }
  read -r name ns ref _ <<<"$line"
  exec kubectl --request-timeout=30s logs -n "$ns" "$ref" --tail="$tail" ${follow:+-f}
}

