help_cmd() {  # command → details
  local x="$1" prev="" q cfg1=""
  [ -z "$(profile)" ] || cfg1=$(configs_of "$(profile)" | awk '{print $1}')
  row() { printf "  ${C_DIM}%-12s${C_0} %s\n" "$1" "$2"; }
  case " $PHASES " in
    *" $x "*)
      for q in $PHASES; do [ "$q" = "$x" ] && break; prev=$q; done
      printf '%s\n' "${C_B}./reproduce $x$(case "$x" in measure) echo " [configuration]" ;; evaluate|package) echo " [results folder]" ;; esac)${C_0} – $(phase_desc "$x")"
      row phase "$(phase_no "$x") of 9 · usually $(phase_time "$x")"
      row runs "$(in_background "$x" && echo "in the background – the terminal can be closed" || echo "in this terminal")"
      [ -z "$prev" ] || row "needs first" "$prev (checked, not repeated automatically)"
      case "$x" in
        install) row sudo "yes – installs k3s, switches off swap and automatic updates (uninstall restores them)" ;;
        measure) row configs "${cfg1:+$(configs_of "$(profile)" | sed 's/ /, /g') · }without argument: all, $(eff_reps) valid runs each"
                 row "short test" "REPRODUCE_SMOKE=1 REPRODUCE_REPS=1 ./reproduce measure" ;;
      esac
      row example "./reproduce $x$( [ "$x" = measure ] && [ -n "$cfg1" ] && echo " $cfg1")" ;;
    *)
      case "$x" in
        status)    printf '%s\n' "${C_B}./reproduce status [--json]${C_0} – phases, runs, estimate, the running job and the next step"; row json "machine-readable, for scripts" ;;
        dashboard|ui) printf '%s\n' "${C_B}./reproduce dashboard${C_0} – full-screen live view (alias: ui)"
                   row keys "q quit · s stop the job · l log · p pods · ? help · r refresh"; row "--once" "print one frame and exit (also used without a terminal)" ;;
        watch)     printf '%s\n' "${C_B}./reproduce watch [--all]${C_0} – follow the background job line by line; Ctrl-C closes only the view"; row "--all" "the full log incl. helm and kubectl output" ;;
        logs)      printf '%s\n' "${C_B}./reproduce logs [component] [-f] [--tail n]${C_0} – logs of a component"; row list "./reproduce logs"; row example "./reproduce logs edc-customer --tail 300" ;;
        stop)      printf '%s\n' "${C_B}./reproduce stop${C_0} – the job finishes its current step, then stops cleanly; a run in progress is closed as invalid"; row continue "the same command as before – work already done is skipped" ;;
        settings)  printf '%s\n' "${C_B}./reproduce settings [key [value]]${C_0} – show or change: ${SETTING_KEYS// / · }"; row example "./reproduce settings tz Europe/Berlin" ;;
        uninstall) printf '%s\n' "${C_B}./reproduce uninstall [--yes]${C_0} – removes k3s with all pods and volumes, restores swap and automatic updates"; row kept "src/, results/, state/s0/" ;;
        bundle)    printf '%s\n' "${C_B}./reproduce bundle${C_0} – charts, images and tools of the running build in bundle/, for a machine without internet" ;;
        help)      help_main ;;
        *)         unknown_cmd "$x" ;;
      esac ;;
  esac
}
cmd_help() { if [ -z "${1:-}" ]; then help_main; else help_cmd "$1"; fi; }
unknown_cmd() {
  local m; m=$(py closest "$1" $ALL_CMDS)
  tell "✗" "unknown command: $1"
  [ -z "$m" ] || tell "→" "did you mean: ./reproduce $m"
  tell "→" "all commands: ./reproduce help"; exit 2
}

# ── status, watch, stop ───────────────────────────────────────────────────────────
phase_state() {  # phase → 0 done
  local rd c v i
  case "$1" in
    fetch)   [ -e "$SRC/.git" ] ;;
    tools)   [ -x "$TOOLS/helm" ] && [ -x "$TOOLS/kubectl" ] ;;
    check)   [ -n "$(profile)" ] ;;
    install) [ -f "$OWNER" ] ;;
    deploy)  [ -f "$STATE/config" ] ;;
    prepare) [ -f "$STATE/s0/SHA256SUMS" ] ;;
    verify)  [ -f "$STATE/verified" ] ;;
    measure)
      rd=$(cat "$STATE/results-current" 2>/dev/null) && [ -d "$rd" ] || return 1
      for c in $(configs_of "$(profile)"); do read -r v i <<<"$(count_runs "$rd" "$c")"; [ "$v" -ge "$(eff_reps)" ] || return 1; done ;;
    evaluate)   # done only after a complete measurement and newer than every run (an older evaluation does not count)
      rd=$(cat "$STATE/results-current" 2>/dev/null) && [ -f "$rd/summary.json" ] && phase_state measure \
        && [ -z "$(find "$rd" -maxdepth 1 -name '*_rep-*' -newer "$rd/summary.json" -print -quit)" ] ;;
    package)    # done only if the checksums are newer than the evaluation
      rd=$(cat "$STATE/results-current" 2>/dev/null) && [ -f "$rd/SHA256SUMS" ] && phase_state evaluate && [ ! "$rd/summary.json" -nt "$rd/SHA256SUMS" ] ;;
  esac
}
last_status_line() { grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} ' "$LOGF" 2>/dev/null | tail -n 1; }
last_step_line() { grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} (…|✓|↷|━━) ' "$LOGF" 2>/dev/null | tail -n 1; }   # progress of the job itself
last_line_age() {  # [line] → seconds since that line (default: the last status line)
  local t; t=$( { [ -n "${1:-}" ] && echo "$1" || last_status_line; } | cut -c1-8)
  [ -n "$t" ] || { echo 0; return 0; }
  echo $(( ( $(date -u +%s) % 86400 - $(date -u -d "1970-01-01 $t" +%s) + 86400 ) % 86400 ))
}
cmd_status() {
  local p rd cfg x st n="" ph="" v i
  p=$(profile)
  ! job_alive || ph=$(sed -n 's/.*phase=\([^ :]*\).*/\1/p' "$STATE/job")
  printf '%s\n' "${C_B}reproduce · PURIS saturation experiment${C_0}"
  printf '  %-12s %s\n' "work folder" "$(rel "$WORK")" "repository" "$(commit 2>/dev/null | cut -c1-7 || true)" \
    "profile" "${p:-– (not checked yet)}${p:+ – configurations $(configs_of "$p" | sed 's/ /, /g')}"
  [ ! -f "$STATE/config" ] || printf '  %-12s %s\n' "deployed" "$(cat "$STATE/config")"
  echo
  for x in $PHASES; do
    if [ "$x" = "$ph" ]; then st="$C_RUN…$C_0"
    elif phase_state "$x"; then st="$C_OK✓$C_0"
    else st="$C_DIM○$C_0"; [ -n "$n" ] || n=$x; fi
    printf '  %s %s %-9s %s\n' "$st" "$(phase_no "$x")" "$x" "$C_DIM$(phase_desc "$x")$C_0"
  done
  echo
  rd=$(cat "$STATE/results-current" 2>/dev/null || true)
  if [ -n "$rd" ] && [ -d "$rd" ]; then
    printf '  %-12s %s\n' "results" "$(rel "$rd")"
    for cfg in $(configs_of "$p"); do read -r v i r <<<"$(run_counts "$rd" "$cfg")"; printf '  %-12s %s\n' "" "$cfg: $v valid, $i invalid$( [ "$r" = 1 ] && echo ", 1 running") (target: $(eff_reps) valid)"; done
    ! phase_state evaluate || printf '  %-12s %s\n' "verdict" "$(rel "$rd/verdict.md")"   # only a current evaluation
  fi
  [ -z "$(eta_line)" ] || printf '  %-12s %s\n' "estimate" "$(eta_line)"
  # open multi-step changes are "in progress" while a job runs, "interrupted" only without one
  [ -z "$(ls "$MARKERS" 2>/dev/null)" ] || job_alive || printf '  %-12s %s\n' "interrupted" "$(ls "$MARKERS" | tr '\n' ' ')– completed automatically by the next command"
  if job_alive; then
    printf '  %-12s %s\n' "job" "running in the background – phase ${ph:-?}, PID $(job_pid), since $(sed -n 's/.*started=[0-9-]*T\([0-9:]*\):[0-9]*Z.*/\1/p' "$STATE/job") UTC" \
      "last line" "$(last_status_line) ($(dur "$(last_line_age)") ago)"
    printf '\n%s\n' "${C_B}→ follow it: ./reproduce dashboard${C_0}  ${C_DIM}(full-screen) · or: ./reproduce watch${C_0}"
  else
    printf '  %-12s %s\n' "job" "none running"
    if [ -n "$n" ]; then printf '\n%s\n' "${C_B}→ next: ./reproduce $n${C_0}  $C_DIM($(phase_desc "$n") · usually $(phase_time "$n"))$C_0"
    else printf '\n%s\n' "${C_B}→ all phases done – results: $(rel "$rd")${C_0}"; fi
  fi
  printf '%s\n' "${C_DIM}  kubectl: export KUBECONFIG=$KUBECONFIG PATH=$TOOLS:\$PATH${C_0}"
}
TICKER=0; TK_EXTRA=""
tk_update() {  # every 30 s: overall percentage and end time for the live line, the tab title and the tab progress
  local m x t pct
  read -r m x t <<<"$(eta_minutes)"
  [ "$t" -gt 0 ] && [ "$m" -gt 0 ] || { TK_EXTRA=""; return 0; }
  pct=$(( (t - m) * 100 / t )); TK_EXTRA=" · $pct % · done ≈ $(date -d "+$m min" +%H:%M)"
  tab_progress "1;$pct"; tab_title "reproduce · $(job_field phase | cut -d: -f1) · $pct %"
}
ticker() {  # seconds since the last status line, that line without its time → one live line, always narrower than the terminal
  [ "$TTY" = 1 ] || return 0
  local txt="$2" w
  case "$txt" in
    "… "*) txt=${txt#"… "}; txt=${txt%% (*}; txt=${txt%% – *} ;;   # the running step, without its note
    *)     txt="working on $(sed -n 's/.*phase=\([^ :]*\).*/\1/p' "$STATE/job" 2>/dev/null)" ;;
  esac
  txt="$txt · $(dur "$1")$TK_EXTRA"
  w=$(( $(tput cols 2>/dev/null || echo 80) - 13 )); [ "$w" -ge 20 ] || w=20
  printf '\r\033[K         %s %s' "$C_RUN${SPIN[$((SECONDS % 10))]}$C_0" "$C_DIM${txt:0:$w}$C_0"
  TICKER=1
}
ticker_clear() { [ "$TICKER" = 1 ] && printf '\r\033[K'; TICKER=0; return 0; }
cmd_watch() {  # [--all | --from byte-offset] → status lines of the background job, live
  [ -f "$LOGF" ] || { echo "nothing to show yet – no log"; return 0; }
  local re='^[0-9]{2}:[0-9]{2}:[0-9]{2} ' sre='^[0-9]{2}:[0-9]{2}:[0-9]{2} (…|✓|↷|━━) ' from="" line rc t_last ended=0 last
  case "${1:-}" in --all) re='' ;; --from) from="${2:-0}" ;; esac
  if [ -z "$from" ]; then
    if [ -z "$re" ]; then tail -n 40 "$LOGF"; else grep -E "$re" "$LOGF" | tail -n 15 | while IFS= read -r line; do paint "$line"; done; fi
    from=$(stat -c %s "$LOGF")
    job_alive || { printf '\n%s\n' "no job is running – overview: ./reproduce status"; return 0; }
    printf '%s\n' "${C_DIM}         (live view of the background job – Ctrl-C closes only this view)${C_0}"
  else
    for _ in $(seq 1 15); do job_alive && break; [ "$(stat -c %s "$LOGF")" -le "$from" ] || break; sleep 1; done   # a job started just now registers itself
  fi
  exec 8< <(tail -c +"$((from + 1))" -F --pid=$$ "$LOGF" 2>/dev/null | grep --line-buffered -E "$re")
  trap 'ticker_clear; printf "\n%s\n" "(view closed – the job keeps running · ./reproduce watch opens it again)"; exit 0' INT TERM HUP   # a view never writes into the job's log
  last=$(last_step_line); t_last=$((SECONDS - $(last_line_age "$last"))); last=${last#* }
  local tk_t=-100
  while :; do
    if [ "$TTY" = 1 ] && [ $((SECONDS - tk_t)) -ge 30 ]; then tk_t=$SECONDS; tk_update; fi
    if IFS= read -r -t 1 line <&8; then
      ticker_clear; if [ -z "$re" ]; then printf '%s\n' "$line"; else paint "$line"; fi
      if [[ $line =~ $sre ]]; then t_last=$SECONDS; last=${line#* }; fi
    else
      rc=$?; [ "$rc" -gt 128 ] || break
      if job_alive; then ticker $((SECONDS - t_last)) "$last"; elif [ "$ended" = 1 ]; then break; else ended=1; fi
    fi
  done
  ticker_clear; tab_progress "0;0"; tab_title "reproduce · job ended"
  if grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} ' "$LOGF" | tail -n 4 | grep -q '^.\{8\} ✗ '; then notify_end "reproduce: the job stopped with an error"; printf '\n%s\n' "${C_ERR}(the job stopped with an error – see the ✗ line above)${C_0}"
  else notify_end "reproduce: the job has ended"; printf '\n%s\n' "(the job has ended – overview: ./reproduce status)"; fi
}
cmd_stop() {
  job_alive || { echo "no job is running – nothing to stop"; return 0; }
  local p c t0=$SECONDS last; p=$(job_pid); c=$(sed -n 's/.*command=\([^ ]*\).*/\1/p' "$STATE/job")
  kill -TERM "$p"
  info "stop requested (PID $p) – the job finishes its current step and then stops cleanly; nothing is lost"
  info "a step that waits for pods ends when they are ready or at its maximum time – this can take a while"
  trap 'ticker_clear; printf "\n%s\n" "(the stop request stays – the job stops at the next safe point · ./reproduce status)"; exit 0' INT TERM HUP
  while job_alive; do last=$(last_step_line); last=${last#* }; ticker $((SECONDS - t0)) "… stopping after the current step: ${last#* }"; sleep 1; done
  ticker_clear
  ok "job stopped ($(dur $((SECONDS - t0))))"
  [ "$c" = _continue ] && c="" ; hint "continue later with: ./reproduce${c:+ $c} – steps already done are skipped"
}

# ── uninstall and bundle ──────────────────────────────────────────────────────────
cmd_uninstall() {
  [ -f $OWNER ] || die "no cluster of this script on this machine – nothing removed" 3
  if [ "${1:-}" != --yes ]; then
    echo "This removes k3s with all pods and volumes, and restores the system settings."
    echo "Kept: $SRC, $RESULTS, $STATE/s0. Type 'uninstall' to continue:"
    local a; read -r a; [ "$a" = uninstall ] || { echo "cancelled"; exit 4; }
  fi
  job_alive && die "a job is running – ./reproduce stop first"
  q sudo /usr/local/bin/k3s-uninstall.sh || die "k3s-uninstall.sh failed"
  if [ -f "$STATE/system-before.json" ]; then
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["apt-daily.timer"], d["apt-daily-upgrade.timer"], d["snap_hold"], d["swap_active"])' "$STATE/system-before.json" | {
      read -r a1 a2 sh sw
      [ "$a1" != enabled ] || q sudo systemctl enable --now apt-daily.timer
      [ "$a2" != enabled ] || q sudo systemctl enable --now apt-daily-upgrade.timer
      [ "$sh" = True ] || { ! command -v snap >/dev/null || q sudo snap refresh --unhold; }
      if [ "$sw" = True ] && [ -f /etc/fstab.reproduce-bak ]; then q sudo cp /etc/fstab.reproduce-bak /etc/fstab; q sudo swapon -a; fi
    }
  fi
  sudo rm -f "$OWNER" /etc/rancher/k3s/config.yaml
  rm -f "$KUBECONFIG" "$STATE/config" "$STATE/verified" "$STATE/boot_id" "$STATE/results-current"; rm -rf "$STATE/releases" "$MARKERS"
  ok "removed; system settings restored. Results kept in $RESULTS"
}
cmd_bundle() {
  [ -f "$STATE/config" ] || need_fail "nothing deployed" "./reproduce deploy"
  local u="https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION/+/%2B}"
  mkdir -p "$BUNDLE/k3s" "$BUNDLE/charts" "$BUNDLE/tools"
  cp "$TOOLS/helm" "$TOOLS/kubectl" "$BUNDLE/tools/"; cp "$STATE/charts"/*.tgz "$BUNDLE/charts/"
  git -C "$SRC" bundle create "$BUNDLE/src.bundle" --all >>"$LOGF" 2>&1
  ( cd "$BUNDLE/k3s" && curl -fsSLO "$u/k3s" && curl -fsSLO "$u/k3s-airgap-images-amd64.tar.zst" && curl -fsSLO "$u/sha256sum-amd64.txt" \
    && grep -E ' (k3s|k3s-airgap-images-amd64.tar.zst)$' sha256sum-amd64.txt | sha256sum -c --quiet && curl -fsSL https://get.k3s.io -o install.sh ) >>"$LOGF" 2>&1 \
    || die "k3s files for the bundle could not be downloaded"
  step "exporting images"
  # shellcheck disable=SC2046
  q sudo k3s ctr -n k8s.io images export "$BUNDLE/images.tar" $(py images "$STATE/render"/"$(profile)"-k*/*.yaml) || die "image export failed"
  sudo chown "$(id -u):$(id -g)" "$BUNDLE/images.tar"
  ( cd "$BUNDLE" && find . -type f ! -name SHA256SUMS | LC_ALL=C sort | xargs sha256sum > SHA256SUMS )
  ok "bundle: $BUNDLE ($(du -sh "$BUNDLE" | cut -f1)) – licences of the images must be checked before publishing"
}

# ── Main ──────────────────────────────────────────────────────────────────────────
on_exit() {
  local rc=$?
  [ "$rc" -ne 0 ] || tab_progress "0;0"
  [ "$BG" != 1 ] || echo "$rc" > "$STATE/job-exit" 2>/dev/null || true
  if [ "$rc" -ne 0 ] && [ "$LOCKED" = 1 ] && [ -s "$KUBECONFIG" ]; then
    if marker_has run; then stop_own_load; py attempt "$(marker_get run)" "${CURRENT_PHASE:-}" failed "stopped (exit $rc)" 2>/dev/null || true; marker_clear run; fi
  fi
  [ -z "$SUDO_KEEP" ] || kill "$SUDO_KEEP" 2>/dev/null || true
  unlock
  [ "$BG" != 1 ] || case "$SCRIPT" in "$STATE"/job-script.*) rm -f "$SCRIPT" ;; esac   # own copy of the background job
  return "$rc"
}
on_term() {
  case "${CMD:-all}" in   # only commands that do work can be continued; views and helpers close quietly
    all|_continue|fetch|tools|check|install|deploy|prepare|verify|measure|evaluate|package|bundle|uninstall) ;;
    *) exit 0 ;;
  esac
  progress_end; warn "stopped – run $(retry_cmd) again to continue; steps already done are skipped"; exit 4
}
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0   # sourced (tests): functions only
CMD="${1:-all}"; ARGS_TEXT="$*"
for a in "$@"; do case "$a" in -h|--help) [ "$CMD" = "$a" ] && cmd_help || cmd_help "$CMD"; exit 0 ;; esac; done   # help never runs anything
trap on_exit EXIT
trap on_term TERM INT HUP
case "$CMD" in
  all)
    if job_alive; then   # a job is running: show it instead of an error
      tell "·" "a job is already running – opening the live view (q closes it; the job keeps running)"
      if [ "$TTY" = 1 ]; then cmd_dashboard; else cmd_status; fi; exit 0
    fi
    banner; lock; sudo_once
    for x in fetch tools check; do run_phase "$x"; done
    eta_info
    run_phase install
    detach _continue ;;
  _continue)
    lock; eta_info; for x in deploy prepare verify measure evaluate package; do run_phase "$x"; done
    ok "finished – all phases done"
    hint "results: $(rel "$(cat "$STATE/results-current")") · readable summary: verdict.md in that folder" ;;
  fetch|tools|check|install|verify) lock; run_phase "$CMD"; phase_done_hint "$CMD" ;;
  deploy|prepare) detach "$CMD"; lock; run_phase "$CMD"; phase_done_hint "$CMD" ;;
  measure) detach "$@"; lock; shift; run_phase measure "${1:-}"; phase_done_hint measure ;;
  evaluate|package) shift; run_phase "$CMD" "${1:-}"; phase_done_hint "$CMD" ;;
  status) if [ "${2:-}" = --json ]; then cmd_snapshot; else cmd_status; fi ;;
  _snapshot) cmd_snapshot ;;
  dashboard|ui) cmd_dashboard "${2:-}" ;;
  logs|log) shift; cmd_logs "$@" ;;
  settings) shift; cmd_settings "$@" ;;
  watch)  cmd_watch "${2:-}" ;;
  stop)   cmd_stop ;;
  bundle) lock; cmd_bundle ;;
  uninstall) lock; shift; cmd_uninstall "${1:-}" ;;
  make-reference) shift; py make-reference "$@" ;;
  help|-h|--help) cmd_help "${2:-}" ;;
  *) unknown_cmd "$CMD" ;;
esac
exit
}
