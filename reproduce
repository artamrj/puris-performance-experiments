PROM = "/api/v1/namespaces/monitoring/services/http:monitoring-kube-prometheus-prometheus:9090/proxy"
LOKI = "/api/v1/namespaces/logging/services/http:loki:3100/proxy"
SEL = {"customer_puris": '{namespace="customer", pod=~"puris-backend.*"}',
       "supplier_puris": '{namespace="supplier", pod=~"puris-backend.*"}',
       "edc_warn_error": '{namespace=~"customer|supplier", pod=~"edc-controlplane.*"} |~ "\\"level\\":\\"(WARN|ERROR)\\""'}
PAT = {"triggered": "Trigger Reported MaterialStockUpdate", "completed": "Updated ReportedMaterialItemStocks",
       "failed": "Error in ReportedMaterialItemStockRequest", "invalidating_contract": "Invalidating ",
       "optimistic_lock": "ObjectOptimisticLockingFailureException"}
LIMIT = 5000
def loki_range(sel, s, e):
    qs = urllib.parse.urlencode({"query": sel, "start": s, "end": e - 1, "limit": LIMIT, "direction": "forward"})
    res = json.loads(kraw("%s/loki/api/v1/query_range?%s" % (LOKI, qs)))["data"]["result"]
    return [(int(ts), st["stream"].get("pod", ""), line) for st in res for ts, line in st["values"] if s <= int(ts) < e]
def loki_window(sel, s, e):
    rows = loki_range(sel, s, e)
    if len(rows) < LIMIT: return rows
    mid = (s + e) // 2
    if mid <= s: raise ValueError("Loki window not divisible – completeness not provable")
    return loki_window(sel, s, mid) + loki_window(sel, mid, e)
def loki_all(sel, s, e, w=60 * 10**9):
    out, t = [], s
    while t < e:
        x = min(t + w, e); out += loki_window(sel, t, x); t = x
    out.sort(); return out
def loki_count(sel, filt, start):
    end = datetime.now(timezone.utc); rng = int((end - start).total_seconds()) + 1
    qs = urllib.parse.urlencode({"query": 'sum(count_over_time(%s |= "%s" [%ds]))' % (sel, filt, rng), "time": end.timestamp()})
    res = json.loads(kraw("%s/loki/api/v1/query?%s" % (LOKI, qs)))["data"]["result"]
    return int(float(res[0]["value"][1])) if res else 0
def prom_query(q):
    res = json.loads(kraw("%s/api/v1/query?%s" % (PROM, urllib.parse.urlencode({"query": q}))))["data"]["result"]
    return float(res[0]["value"][1]) if res else None
