SETTING_KEYS="tz color title progress notify"
cmd_settings() {  # [key [value]] – shown without arguments; "default" resets a key
  local k="${1:-}" v="${2:-}" tmp
  if [ -z "$k" ]; then
    printf '%s\n' "${C_B}settings${C_0}  ${C_DIM}$(rel "$SETTINGS") · environment variables win (TZ, NO_COLOR, FORCE_COLOR)${C_0}"
    printf "  %-9s ${C_B}%-15s${C_0} %s\n" \
      tz "$( [ -n "$(setting tz)" ] && setting tz || echo "server ($(date +%Z))")" "${C_DIM}time zone of all times shown, e.g. Europe/Berlin, UTC${C_0}" \
      color "$(setting color)" "${C_DIM}auto · always · never${C_0}" \
      title "$(setting title)" "${C_DIM}terminal tab shows phase and progress: on · off${C_0}" \
      progress "$(setting progress)" "${C_DIM}progress bar in the terminal tab (Windows Terminal, Ghostty, iTerm2 3.6.6+): auto · on · off${C_0}" \
      notify "$(setting notify)" "${C_DIM}when a job ends while watch or dashboard is open: bell · desktop · off${C_0}"
    printf '\n%s\n' "${C_DIM}change: ./reproduce settings <key> <value> · reset: ./reproduce settings <key> default${C_0}"
    return 0
  fi
  case " $SETTING_KEYS " in *" $k "*) ;; *) tell "✗" "unknown setting: $k"; tell "→" "settings: ${SETTING_KEYS// / · }"; exit 2 ;; esac
  [ -n "$v" ] || { setting "$k"; return 0; }
  case "$k:$v" in
    *:default) ;;
    tz:*) [ -f "/usr/share/zoneinfo/$v" ] || { tell "✗" "unknown time zone: $v"; tell "→" "examples: Europe/Berlin · UTC · America/New_York (all: timedatectl list-timezones)"; exit 2; } ;;
    color:auto|color:always|color:never|title:on|title:off|progress:auto|progress:on|progress:off|notify:bell|notify:desktop|notify:off) ;;
    *) tell "✗" "invalid value for $k: $v"; tell "→" "see: ./reproduce settings"; exit 2 ;;
  esac
  tmp=$(mktemp "$STATE/settings.XXXXXX"); grep -v "^$k=" "$SETTINGS" 2>/dev/null > "$tmp" || true
  [ "$v" = default ] || echo "$k=$v" >> "$tmp"; mv "$tmp" "$SETTINGS"
  tell "✓" "$k = $( [ -n "$(setting "$k")" ] && setting "$k" || echo "server time zone ($(date +%Z))")$( [ "$v" = default ] && echo " (default)")"
}

