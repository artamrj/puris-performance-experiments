def puris(role, key):
    ip = kubectl("get", "svc", "puris-backend", "-n", role, "-o", "jsonpath={.spec.clusterIP}").strip()
    base = "http://%s:8081/catena/" % ip
    def req(method, path, body=None):
        r = urllib.request.Request(base + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                   headers={"X-API-KEY": key, "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(r, timeout=30) as resp: return resp.status, resp.read().decode()
        except urllib.error.HTTPError as e: return e.code, e.read().decode()[:300]
    return req
def b64(s): return base64.b64encode(s.encode()).decode()
def materials(tsv):
    rows = []
    for l in open(tsv):
        if l.startswith("#") or not l.strip(): continue
        p = l.rstrip("\n").split("\t")
        if p[0] == "nr": continue
        rows.append({"nr": p[0], "mc": p[1], "ms": p[2], "cx": p[3], "name": p[4]})
    return rows
def cmd_testdata(role, src, key, wait_s="180"):
    req, wait_s = puris(role, key), int(wait_s)
    base = os.path.join(src, "setup/e1-testdaten")
    tpl = lambda f: json.load(open(os.path.join(base, role, f)))
    def post(path, body):
        code, txt = req("POST", path, body)
        if code not in (200, 201, 409): raise SystemExit("POST %s -> HTTP %s: %s" % (path, code, txt[:300]))
        return code
    def get(path):
        code, txt = req("GET", path)
        if code != 200: raise SystemExit("GET %s -> HTTP %s" % (path, code))
        return json.loads(txt)
    dtr = "/api/v1/namespaces/%s/services/http:dtr:8080/proxy/api/v3/shell-descriptors?limit=1000" % role
    twins = lambda: json.loads(kraw(dtr)).get("result", [])
    partner = tpl("1-partner.json")
    if any(p.get("bpnl") == partner["bpnl"] for p in get("partners/all")): print("partner present")
    else: post("partners", partner); print("partner created")
    for k, m in enumerate(materials(os.path.join(base, "materialien.tsv")), 1):
        t0 = time.time(); own = m["ms"] if role == "supplier" else m["mc"]
        existing = [x for x in get("materials/all") if x.get("ownMaterialNumber") == own]
        if existing:
            if existing[0].get("name") != m["name"]:
                raise SystemExit("material %s exists with a different name (%s) – test data were changed outside this script" % (own, existing[0].get("name")))
            c_mat = "present"
        else:
            body = tpl("2-material.json"); body["ownMaterialNumber"] = own; body["name"] = m["name"]
            if role == "supplier": body["materialNumberCx"] = m["cx"]
            c_mat = post("materials", body)
        rel = tpl("3-relation.json"); rel["ownMaterialNumber"] = own; rel["partnerMaterialNumber"] = m["mc"] if role == "supplier" else m["ms"]
        c_rel = post("materialpartnerrelations", rel)
        if role == "supplier":
            if get("stockView/product-stocks?ownMaterialNumber=" + urllib.parse.quote(b64(own))): c_stk = "present"
            else:
                st = tpl("4-product-stock.json"); mat = st["material"]
                mat.update(materialNumberCustomer=m["mc"], materialNumberSupplier=m["ms"], materialNumberCx=m["cx"], name=m["name"])
                c_stk = post("stockView/product-stocks", st)
            done = lambda: len(twins()) >= k
        else:
            c_stk = "-"; done = lambda: any(t.get("id") == m["cx"] for t in twins())
        while not done() and time.time() - t0 < wait_s: time.sleep(3)
        if not done(): raise SystemExit("twin of material %s not in the DTR of %s after %s s" % (own, role, wait_s))
        print("%s %s: material %s, relation %s, stock %s, twin ok (%d s)" % (m["nr"], own, c_mat, c_rel, c_stk, time.time() - t0), flush=True)

