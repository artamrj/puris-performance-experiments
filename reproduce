MARK = re.compile(r'msg="K6_STAGE ((?:[^"\\]|\\.)*)"|^K6_STAGE (\{.*\})$')
def stage_markers(text):
    starts = {}
    for l in text.splitlines():
        m = MARK.search(l.strip())
        if not m: continue
        row = json.loads(json.loads('"%s"' % m[1]) if m[1] is not None else m[2])
        if starts.setdefault(row["stage"], row["start_ms"]) != row["start_ms"]:
            raise ValueError("conflicting start times for stage %s" % row["stage"])
    return starts
def runner_pod(name):
    pods = json.loads(kubectl("get", "pods", "-n", "k6", "-o", "json"))["items"]
    return next((p for p in pods if p["metadata"]["name"].startswith(name + "-1-")), None)
def cmd_watchdog(name, t_apply, labels, stage_min):
    """exit 0 = finished, 10 = still running and on schedule, 11 = stalled (message on stdout)"""
    labels = labels.split(","); stage_ms = float(stage_min) * 60000; now = time.time() * 1000
    apply_ms0 = parse(t_apply).timestamp() * 1000
    try: st = json.loads(kubectl("get", "testrun", name, "-n", "k6", "-o", "json")).get("status", {}).get("stage")
    except Exception as e:
        if now - apply_ms0 > len(labels) * stage_ms + 25 * 60000: print("TestRun not readable: %s" % e); sys.exit(11)
        print("TestRun status not readable yet"); sys.exit(10)
    if st == "finished": sys.exit(0)
    if st == "error": print("TestRun in state error"); sys.exit(11)
    apply_ms = parse(t_apply).timestamp() * 1000
    pod = runner_pod(name); starts = {}
    if pod and pod["status"].get("phase") in ("Running", "Succeeded", "Failed"):
        try: starts = stage_markers(kubectl("logs", "-n", "k6", pod["metadata"]["name"]))
        except RuntimeError: starts = {}
    if not starts:
        if now - apply_ms > 10 * 60000: print("no load stage started 10 min after start"); sys.exit(11)
        print("waiting for the first stage"); sys.exit(10)
    t0 = starts.get(labels[0])
    for i, l in enumerate(labels):
        planned = t0 + i * stage_ms
        if now > planned + 120000 and l not in starts: print("stage %s missing 2 min after its planned start" % l); sys.exit(11)
    end = t0 + len(labels) * stage_ms
    if now > end + 15 * 60000: print("load did not end 15 min after its planned end"); sys.exit(11)
    cur = max((i for i, l in enumerate(labels) if l in starts), default=0)
    el = (now - (t0 + cur * stage_ms)) / 1000
    print("stage %s (%d/%d) · %02d:%02d / %02d:00" % (labels[cur], cur + 1, len(labels), el // 60, el % 60, float(stage_min)))
    sys.exit(10)

