            sym, sty = {"done": ("✓", "ok"), "running": (SPIN[k % 10], "acc"), "open": ("○", "d")}[p_["state"]]
            c.put(y, xx, sym, sty); xx += 2
        cur = next((p_ for p_ in phases if p_["state"] == "running"), None) or next((p_ for p_ in phases if p_["state"] == "open"), None)
        if cur: c.put(y, xx + 1, "%s · %d of 9" % (cur["name"], phases.index(cur)), "d")
