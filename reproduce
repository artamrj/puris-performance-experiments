def saturated(s, strict):
    planned = s.get("planned") or 1
    trig = max(s.get("triggered_log", 0), 1)
    return (s.get("completed_log", 0) < 0.95 * planned or s.get("failed_log", 0) / trig > 0.01
            or (strict and s.get("invalidating_contract", 0) >= 1))
def judge_run(meta):
    st = [s for s in meta["stages"] if not s["stage"].startswith("warmup") and s["stage"] != "recovery"]
    rec = next((s for s in meta["stages"] if s["stage"] == "recovery"), None)
    out = {}
    for mode, strict in (("strict", True), ("relaxed", False)):
        tip = next((s for s in st if saturated(s, strict)), None)
        before = [s for s in st if tip is None or st.index(s) < st.index(tip)]
        out[mode] = {"tipping_stage": tip["stage"] if tip else None, "tipping_rate": tip["rate_per_s"] if tip else None,
                     "capacity_rate": before[-1]["rate_per_s"] if before else None,
                     "recovered": (not saturated(rec, strict)) if rec else None}
    return out
CP_DEFAULT = {"compact-k0": 0.5, "compact-k1": 1.0, "original-k0": 1.5, "original-k1": 1.5}
def summarize(cfg, metas):
    valid = [m for m in metas if m.get("validity", {}).get("valid")]
    grid = [s["rate_per_s"] for s in (valid or metas or [{"stages": []}])[0]["stages"] if not s["stage"].startswith("warmup") and s["stage"] != "recovery"]
    res = {"configuration": cfg, "runs_total": len(metas), "runs_valid": len(valid), "stage_grid": grid, "runs": []}
    for m in valid:
        j = judge_run(m); cp = m.get("edc_controlplane_customer_cpu_limit") or CP_DEFAULT.get(cfg)
        res["runs"].append({"run": m["run"], "machine": (m.get("machine") or {}).get("cpu_model") or (m.get("node") or {}).get("cpu_model"), **j,
                            "tx_per_s_per_core": round(j["strict"]["capacity_rate"] / cp, 3) if cp and j["strict"]["capacity_rate"] else None})
    for mode in ("strict", "relaxed"):
        rates = [r[mode]["tipping_rate"] for r in res["runs"]]
        num = [r if r is not None else math.inf for r in rates]
        res[mode] = {"tipping_rates": rates, "tipping_min": min(num) if num else None, "tipping_max": max(num) if num else None,
                     "tipping_median": statistics.median(num) if num else None,
                     "recovered": [r[mode]["recovered"] for r in res["runs"]]}
    return res
def compare(summary, ref, mode="strict"):
    grid = summary["stage_grid"]
    if not ref or not grid: return {"verdict": "no reference"}
    lo, hi = ref[mode]["tipping_min"], ref[mode]["tipping_max"]
    med = summary[mode]["tipping_median"]
    if med is None: return {"verdict": "no valid runs"}
    def idx(v): return len(grid) if v == math.inf or v is None else min(range(len(grid)), key=lambda i: abs(grid[i] - v))
    i_lo, i_hi, i_med = idx(lo) - 1, idx(hi) + 1, idx(med)
    ok = i_lo <= i_med <= i_hi
    return {"verdict": "reproduced" if ok else "not reproduced", "reference_range": [lo, hi],
            "accepted_range": [grid[max(i_lo, 0)], grid[min(i_hi, len(grid) - 1)]], "median": med}
def load_metas(folder):
    out = []
    for d in sorted(os.listdir(folder)):
        p = os.path.join(folder, d, "meta.json")
        if os.path.isfile(p): out.append(rjson(p))
    return out
def fmt(v): return "–" if v is None else ("not saturated" if v == math.inf else "%g/s" % v)
def cmd_evaluate(folder, refdir):
    metas = load_metas(folder); cfgs = sorted({m.get("configuration") for m in metas if m.get("configuration")})
    summary = {"results": os.path.basename(folder), "configurations": {}}
    lines = ["# Result – %s" % os.path.basename(folder), ""]
    mach = rjson(os.path.join(folder, "machine.json")) if os.path.exists(os.path.join(folder, "machine.json")) else {}
    if mach: lines += ["Machine: %s · %s vCPU · %s GiB · single-core score %s" % (mach.get("cpu_model"), mach.get("vcpu"), mach.get("mem_total_gib"), mach.get("cpu_single_core_score")), ""]
    if any(m.get("kind") == "smoke" for m in metas):
        lines += ["> **Short test (2-min stages):** checks that the pipeline works. The numbers are not comparable with the reference or the thesis – with short stages no backlog builds up in time.", ""]
    lines += ["| Configuration | valid runs | tipping stage (median, range) | capacity | tx/s per core | recovery | comparison |", "|---|---|---|---|---|---|---|"]
    for cfg in cfgs:
        s = summarize(cfg, [m for m in metas if m.get("configuration") == cfg])
        rp = os.path.join(refdir, cfg + ".json"); ref = rjson(rp) if os.path.exists(rp) else None
        s["comparison"] = compare(s, ref); s["comparison_relaxed"] = compare(s, ref, "relaxed")
        if any(m.get("kind") == "smoke" for m in metas if m.get("configuration") == cfg):   # 2-min stages: no backlog builds up in time
            s["comparison"] = s["comparison_relaxed"] = {"verdict": "not compared (short test)", "short_test": True}
        summary["configurations"][cfg] = s; st = s["strict"]
        caps = [r["strict"]["capacity_rate"] for r in s["runs"] if r["strict"]["capacity_rate"]]
        tps = [r["tx_per_s_per_core"] for r in s["runs"] if r["tx_per_s_per_core"]]
        rec = st["recovered"]
        lines.append("| %s | %d of %d | %s (%s – %s) | %s | %s | %s | %s |" % (cfg, s["runs_valid"], s["runs_total"], fmt(st["tipping_median"]), fmt(st["tipping_min"]), fmt(st["tipping_max"]),
                     fmt(statistics.median(caps)) if caps else "–", ("%.2f" % statistics.median(tps)) if tps else "–",
                     "%d of %d" % (sum(1 for x in rec if x), len(rec)) if rec else "–", s["comparison"]["verdict"]))
    lines += ["", "Saturation criterion: completed < 95 % of the input rate, or > 1 % failed, or ≥ 1 \"Invalidating …\" (strict).",
              "The relaxed reading without the third condition is in summary.json (`relaxed`, `comparison_relaxed`)."]
    wjson(os.path.join(folder, "summary.json"), summary)
    open(os.path.join(folder, "verdict.md"), "w").write("\n".join(lines) + "\n")
    print("\n".join(lines))
def cmd_make_reference(cfg, source, *runs):
    metas = []
