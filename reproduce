def cpu_score(seconds=10.0):
    data, n, t0 = b"puris-reproduce-benchmark" * 3, 0, time.perf_counter()
    while time.perf_counter() - t0 < seconds:
        for _ in range(1000): data = hashlib.sha256(data).digest()
        n += 1000
    return int(n / (time.perf_counter() - t0))
def disk_free_gib(path):
    while not os.path.exists(path): path = os.path.dirname(path)
    return round(shutil.disk_usage(path).free / 2**30, 1)
def cmd_machine(out, work):
    mem = next(int(l.split()[1]) for l in open("/proc/meminfo") if l.startswith("MemTotal:")) * 1024
    model = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "unknown")
    osr = dict(l.rstrip("\n").split("=", 1) for l in open("/etc/os-release") if "=" in l)
    run = lambda *c: subprocess.run(c, capture_output=True, text=True).stdout.strip()
    m = {"time_utc": iso(datetime.now(timezone.utc)), "cpu_model": model, "vcpu": os.cpu_count(),
         "mem_total_gib": round(mem / 2**30, 2), "os": osr.get("PRETTY_NAME", "").strip('"'),
         "os_id": osr.get("ID", ""), "kernel": platform.release(), "arch": platform.machine(),
         "virtualization": run("systemd-detect-virt") or "none", "time_synchronized": run("timedatectl", "show", "-p", "NTPSynchronized", "--value"),
         "disk_free_gib": {"work": disk_free_gib(work), "rancher": disk_free_gib("/var/lib/rancher")},
         "boot_id": open("/proc/sys/kernel/random/boot_id").read().strip(),
         "cpu_single_core_score": cpu_score()}
    wjson(out, m); print(json.dumps(m))

def cmd_steal(seconds):
    def snap():
        f = [int(x) for x in open("/proc/stat").readline().split()[1:9]]
        return f[7], sum(f)
    s0, t0 = snap(); time.sleep(float(seconds)); s1, t1 = snap()
    print("%.4f" % ((s1 - s0) / max(t1 - t0, 1)))

