def cmd_snapshot():
    d = {"phases": [], "runs": {}, "job": None, "interrupted": [], "configs": []}
    for line in sys.stdin.read().splitlines():
        f = line.split("\t"); k = f[0]
        if k == "phase": d["phases"].append({"name": f[1], "state": f[2], "purpose": f[3], "usual": f[4], "background": f[5] == "1"})
        elif k == "job": d["job"] = dict(t.split("=", 1) for t in f[1].split() if "=" in t)
        elif k == "eta":
            m, x, t = int(f[1]), int(f[2]), int(f[3])
            d["estimate"] = {"remaining_min": m, "extra_max_min": x, "total_min": t,
                             "percent": (100 if m == 0 else max(0, min(99, round((t - m) * 100 / t)))) if t else 0,
                             "end_epoch": int(time.time() + m * 60) if m else None}
        elif k == "runs": d["runs"][f[1]] = {"valid": int(f[2]), "invalid": int(f[3]), "running": int(f[4]) if len(f) > 4 else 0}
        elif k in ("configs", "interrupted"): d[k] = f[1].split() if len(f) > 1 else []
        elif k == "reps": d[k] = int(f[1] or 0)
        else: d[k] = f[1] if len(f) > 1 else ""
    print(json.dumps(d, indent=1, ensure_ascii=False))

