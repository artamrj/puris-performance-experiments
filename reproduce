#!/usr/bin/env bash
# shellcheck disable=SC2024,SC2030,SC2031,SC2094  # sudo output into own files; probe in a subshell; log appended while read
# ══════════════════════════════════════════════════════════════════════════════
# reproduce – repeats the PURIS saturation experiment on one machine, from an
# empty Ubuntu server to finished, checked results. Specification: REPRODUCE.md.
#
#   tmux new -s repro      (recommended: keeps running when the terminal or the computer is closed)
#   curl -fsSLO https://raw.githubusercontent.com/artamrj/puris-performance-experiments/main/reproduce
#   chmod +x reproduce && ./reproduce      (not with sudo – it asks for the password itself)
#
# Commands
#   ./reproduce                      everything (phases 0–9)
#   ./reproduce status               state of every phase, profile, runs (read-only)
#   ./reproduce fetch | tools | check | install | deploy | prepare | verify
#   ./reproduce measure [config]     runs; without argument all configurations of the profile
#   ./reproduce evaluate [folder]    tipping stage, metric, comparison with the reference
#   ./reproduce package [folder]     results folder complete, with checksums
#   ./reproduce watch [--all]        follow the background job live (--all: full log; Ctrl-C closes only the view)
#   ./reproduce stop                 end the background job at the next safe point
#   ./reproduce bundle               offline bundle of the running build (needs sudo)
#   ./reproduce uninstall [--yes]    remove the own cluster, restore system settings
#
# Output: one line per step – ✓ done · ↷ already done, skipped · … working · · information
# · ! warning · ✗ error · → what to run next. From phase 4 on the job runs in the background;
# closing the terminal does not stop it. Every stop names the cause and the next command,
# and running the same command again continues where it stopped. NO_COLOR=1: no colours.
#
# Exit codes: 0 success · 1 error · 2 precondition missing · 3 machine too small or
# foreign cluster · 4 stopped by the user.
#
# Test values: the database passwords and the PURIS API key below are fixed, public
# test values ("test only"). They are never used outside this test environment.
# ══════════════════════════════════════════════════════════════════════════════
{ # the whole script is one block: bash reads it completely before running it, so replacing
  # the file while it runs (e.g. downloading a new version) cannot disturb a running call
set -euo pipefail
umask 077

# Runs only on the Linux server of the experiment – stop at once and clearly anywhere else
# (e.g. on a laptop with macOS), before anything is created or locked.
case "${1:-}" in help|-h|--help) ;; *)
  if [ "$(uname -s)" != Linux ]; then
    printf '%s\n' "✗ reproduce runs on the Linux server for the experiment (Ubuntu, amd64) – this machine runs $(uname -s)." \
      "→ log in to the server (e.g. ssh <server>) and run the two commands from the README there; nothing was changed here."
    exit 3
  fi
  if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then printf '%s\n' "✗ bash 4 or newer required – found $BASH_VERSION"; exit 3; fi
  if [ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ]; then
    printf '%s\n' "✗ please start it without sudo: ./reproduce" \
      "→ it asks for the sudo password itself, once at the start; started with sudo, its files would belong to root"
    exit 2
  fi ;;
esac

# ── Fixed versions and sources (REPRODUCE.md §7.2) ────────────────────────────────
REPO_URL="https://github.com/artamrj/puris-performance-experiments.git"
K3S_VERSION="v1.37.1+k3s1"
HELM_VERSION="v4.3.0"
KUBECTL_VERSION="v1.37.1"
PURIS_GIT="https://github.com/eclipse-tractusx/puris.git"
PURIS_TAG="puris-7.2.0"
TX_REPO="https://eclipse-tractusx.github.io/charts/dev"
GF_REPO="https://grafana.github.io/helm-charts"
# block release namespace chart repo version system-under-test
RELEASES="b1-monitoring monitoring monitoring oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack - 91.9.0 0
b2-loki loki logging loki GF 7.3.0 0
b3-alloy alloy logging alloy GF 1.13.0 0
c1-identitaet identity identity identity-and-trust-bundle TX 1.1.3 1
c2-customer-edc edc customer dataspace-connector-bundle TX 1.3.0 1
c4-supplier-edc edc supplier dataspace-connector-bundle TX 1.3.0 1
c3-customer-dtr dtr customer digital-twin-bundle TX 1.3.0 1
c5-supplier-dtr dtr supplier digital-twin-bundle TX 1.3.0 1
d1-puris-customer puris customer PURIS - 7.2.0 1
d2-puris-supplier puris supplier PURIS - 7.2.0 1
f1-k6 k6-operator k6-operator k6-operator GF 4.6.0 0"
# shellcheck disable=SC2034  # read through configs_of
CONFIGS_compact="compact-k0 compact-k1"
# shellcheck disable=SC2034
CONFIGS_original="original-k0 original-k1"
# test only – public, fixed values (REPRODUCE.md §7.5)
TEST_API_KEY="reproduce-test-only-puris-api-key"
TEST_DB_PASSWORD="reproduce-test-only-db"
REPS="${REPRODUCE_REPS:-3}"           # valid runs per configuration
MAX_REPLACEMENTS=2

# ── Paths ─────────────────────────────────────────────────────────────────────────
SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
WORK="${REPRODUCE_HOME:-$(dirname "$SCRIPT")/puris-repro}"
SRC="$WORK/src"; TOOLS="$WORK/tools"; STATE="$WORK/state"; RESULTS="$WORK/results"; BUNDLE="$WORK/bundle"
LOGF="$STATE/logs/reproduce.log"; MARKERS="$STATE/markers"
OWNER=/etc/rancher/reproduce-owner  # outside /etc/rancher/k3s, which k3s creates with mode 700
# paths and fixed values are write-protected: an accidental assignment anywhere (e.g. from a data
# file) stops the script at once with "readonly variable" instead of silently using a wrong path
readonly SCRIPT WORK SRC TOOLS STATE RESULTS BUNDLE LOGF MARKERS OWNER
readonly REPO_URL K3S_VERSION HELM_VERSION KUBECTL_VERSION PURIS_GIT PURIS_TAG TX_REPO GF_REPO RELEASES TEST_API_KEY TEST_DB_PASSWORD REPS MAX_REPLACEMENTS
export KUBECONFIG="$STATE/kubeconfig"
export HELM_CACHE_HOME="$STATE/helm/cache" HELM_CONFIG_HOME="$STATE/helm/config" HELM_DATA_HOME="$STATE/helm/data"
export PATH="$TOOLS:$PATH"
case "${1:-}" in help|-h|--help) ;; *) mkdir -p "$STATE/logs" "$MARKERS" "$RESULTS" ;; esac   # help creates nothing

# ── Settings (./reproduce settings) – environment variables win over the file ───────
SETTINGS="$STATE/settings"; readonly SETTINGS
setting() {  # key → value from the settings file, or the default
  local v; v=$(sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n 1)
  if [ -n "$v" ]; then echo "$v"; else case "$1" in color|progress) echo auto ;; title) echo on ;; notify) echo bell ;; *) echo "" ;; esac; fi
}
if [ -z "${TZ:-}" ] && [ -n "$(setting tz)" ]; then export TZ; TZ=$(setting tz); fi

# ── Output (REPRODUCE.md §4, "Output style") ─────────────────────────────────────
# One status line per step: time (UTC), symbol, text. The same plain line goes into the
# log; on a terminal it is coloured. Long command output goes only into the log (q).
#   ━━ phase   ✓ done   ↷ already done, skipped   … working   · information
#   !  warning   ✗ error   → what to run next
BG="${REPRODUCE_BG:-0}"
if [ "$BG" = 1 ]; then exec >>"$LOGF" 2>&1; fi
TTY=0; [ "$BG" != 1 ] && [ -t 1 ] && TTY=1
COLOR=0   # NO_COLOR (no-color.org) > FORCE_COLOR / CLICOLOR_FORCE > settings > terminal detection
if [ -n "${NO_COLOR:-}" ] || [ "$BG" = 1 ]; then COLOR=0
elif [ "${FORCE_COLOR:-0}" != 0 ] || [ "${CLICOLOR_FORCE:-0}" != 0 ]; then COLOR=1
else case "$(setting color)" in always) COLOR=1 ;; never) COLOR=0 ;; *) [ "$TTY" = 1 ] && [ "${TERM:-dumb}" != dumb ] && COLOR=1 ;; esac; fi
if [ "$COLOR" = 1 ]; then
  C_OK=$'\033[32m' C_WARN=$'\033[33m' C_ERR=$'\033[1;31m' C_RUN=$'\033[36m' C_DIM=$'\033[2m' C_B=$'\033[1m' C_0=$'\033[0m'; REPRODUCE_COLOR=1
else C_OK="" C_WARN="" C_ERR="" C_RUN="" C_DIM="" C_B="" C_0=""; REPRODUCE_COLOR=0; fi
export LOGF REPRODUCE_BG="$BG" REPRODUCE_COLOR
# terminal integration: tab title (OSC 2) and native progress in the tab (OSC 9;4 – Windows Terminal,
# Ghostty 1.2+, iTerm2 3.6.6+, WezTerm); "auto" only where support is known and outside tmux/screen
TITLE=0; [ "$TTY" = 1 ] && [ "$(setting title)" = on ] && TITLE=1
TPROG=0
if [ "$TTY" = 1 ]; then
  case "$(setting progress)" in
    on) TPROG=1 ;;
    auto) if [ -z "${TMUX:-}${STY:-}" ]; then case "${TERM:-}|${TERM_PROGRAM:-}" in *ghostty*|*WezTerm*|*"|vscode") TPROG=1 ;; esac; fi ;;
  esac
fi
tab_title()    { [ "$TITLE" = 1 ] || return 0; printf '\033]2;%s\a' "$1"; }
tab_progress() { [ "$TPROG" = 1 ] || return 0; printf '\033]9;4;%s\a' "$1"; }   # "1;37" percent · "3;0" busy · "2;100" error · "0;0" off
notify_end() {  # text → bell or desktop notification when a job ends while a view is open
  [ "$TTY" = 1 ] || return 0
  case "$(setting notify)" in off) ;; desktop) printf '\a\033]9;%s\a\033]777;notify;reproduce;%s\a' "$1" "$1" ;; *) printf '\a' ;; esac
}
paint() {  # plain status line → coloured line (plain without colours)
  local l="$1" t r s
  [ -n "$C_0" ] || { printf '%s\n' "$l"; return 0; }
  t="${l%% *}"; r="${l#* }"; s="${r%% *}"
  case "$s" in
    "✓")     printf '%s %s%s\n' "$C_DIM$t$C_0" "$C_OK$s$C_0" "${r#"$s"}" ;;
    "…"|"▶") printf '%s %s%s\n' "$C_DIM$t$C_0" "$C_RUN$s$C_0" "${r#"$s"}" ;;
    "↷"|"·") printf '%s\n' "$C_DIM$l$C_0" ;;
    "!")     printf '%s %s\n' "$C_DIM$t$C_0" "$C_WARN$r$C_0" ;;
    "✗")     printf '%s %s\n' "$C_DIM$t$C_0" "$C_ERR$r$C_0" ;;
    "→")     printf '%s %s\n' "$C_DIM$t$C_0" "$C_B$r$C_0" ;;
    "━"*)    printf '\n%s %s\n' "$C_DIM$t$C_0" "$C_B$r$C_0" ;;
    *)       printf '%s\n' "$l" ;;
  esac
}
say() {  # symbol text
  local line; line="$(date -u +%H:%M:%S) $1 $2"
  if [ "$BG" != 1 ]; then [ "$TTY" != 1 ] || printf '\r\033[K'; paint "$line"; fi
  echo "$line" >> "$LOGF"
}
ok()   { say "✓" "$*"; }
skip() { say "↷" "$*"; }
step() { say "…" "$*"; }
info() { say "·" "$*"; }
warn() { say "!" "$*"; }
fail() { say "✗" "$*"; }
hint() { say "→" "$*"; }
tell() { [ "$TTY" != 1 ] || printf '\r\033[K'; paint "$(date -u +%H:%M:%S) $1 $2"; }   # terminal only, not into the log
q()    { "$@" >>"$LOGF" 2>&1; }          # long output only into the log file
rel()  { case "$1" in "$PWD"/*) printf '%s\n' "${1#"$PWD"/}" ;; "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;; *) printf '%s\n' "$1" ;; esac; }
retry_cmd() { case "${CMD:-all}" in all|_continue) echo "./reproduce" ;; *) echo "./reproduce $ARGS_TEXT" ;; esac; }
die()  {  # message [exit code] – every stop says what failed, where to look and what to run next
  progress_end; tab_progress "2;100"; fail "$1"; diagnostics || true
  info "full log: $(rel "$LOGF")"
  hint "fix the cause, then run $(retry_cmd) again – steps already done are skipped"
  exit "${2:-1}"
}
need_fail() { fail "not possible yet: $1"; hint "run first: $2"; exit 2; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
dur() { printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); }   # seconds → 2m05s
# live progress line on a terminal, one plain line per item otherwise (background job, log)
progress() {  # done total text [seconds on the current item]
  local w=24 f bar; f=$(($1 * w / ($2 > 0 ? $2 : 1)))
  bar="$(printf '%*s' "$f" '' | tr ' ' '#')$(printf '%*s' $((w - f)) '' | tr ' ' '-')"
  tab_progress "1;$(($1 * 100 / ($2 > 0 ? $2 : 1)))"
  if [ "$TTY" = 1 ]; then
    printf '\r\033[K%s %s [%s] %d/%d  %s%s' "$C_DIM$(date -u +%H:%M:%S)$C_0" "$C_RUN…$C_0" "$bar" "$1" "$2" "${3:0:60}" "${4:+  ($(dur "$4"))}"
  elif [ -z "${4:-}" ]; then say "…" "$1/$2 $3"; fi
  return 0
}
progress_end() { [ "$TTY" = 1 ] && printf '\r\033[K' && tab_progress "0;0"; return 0; }
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
spin() {  # label expected command... → runs the command with a live timer on a terminal; its stdout passes through
  local label="$1" exp="$2" pid t0=$SECONDS; shift 2
  [ "$TTY" = 1 ] || { "$@"; return; }
  tab_progress "3;0" >&2
  "$@" & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r\033[K%s %s %s  %s%s' "$C_DIM$(date -u +%H:%M:%S)$C_0" "$C_RUN${SPIN[$((SECONDS % 10))]}$C_0" "$label" "$(dur $((SECONDS - t0)))" "${exp:+ (usually $exp)}" >&2
    sleep 1
  done
  printf '\r\033[K' >&2; tab_progress "0;0" >&2
  wait "$pid"
}

# ── Phases: name, purpose, usual duration (shown in headers, hints and status) ──────
PHASES="fetch tools check install deploy prepare verify measure evaluate package"
phase_no() { local i=0 x; for x in $PHASES; do [ "$x" = "$1" ] && { echo "$i"; return 0; }; i=$((i + 1)); done; }
next_of() { local x prev=""; for x in $PHASES; do [ "$prev" = "$1" ] && { echo "$x"; return 0; }; prev=$x; done; }
phase_desc() {
  case "$1" in
    fetch)    echo "download the experiment repository" ;;
    tools)    echo "helm, kubectl and the Helm charts in fixed versions" ;;
    check)    echo "machine scan, requirements, choice of the profile" ;;
    install)  echo "k3s and all container images (asks for the sudo password)" ;;
    deploy)   echo "11 components: monitoring, logs, identity, 2 EDC, 2 DTR, 2 PURIS, k6" ;;
    prepare)  echo "test data, first transactions, database state S0" ;;
    verify)   echo "configuration check and one test transaction" ;;
    measure)  echo "measurement runs per configuration: reset → load → collect" ;;
    evaluate) echo "tipping stage and comparison with the reference" ;;
    package)  echo "checksums for the results folder" ;;
  esac
}
phase_time() {
  case "$1" in
    fetch|evaluate|package) echo "under 1 min" ;;
    tools)   echo "1–3 min" ;;
    check)   echo "about 2 min" ;;
    install) echo "5–20 min" ;;
    deploy)  echo "20–60 min" ;;
    prepare) echo "10–30 min" ;;
    verify)  echo "2–5 min" ;;
    measure) if is_short; then echo "about 30–45 min per run (short test mode)"; else echo "about 2–3 h per run, $(eff_reps) runs per configuration"; fi ;;
  esac
}
in_background() { case "$1" in deploy|prepare|measure) return 0 ;; *) return 1 ;; esac; }
phase_header() { tab_title "reproduce · $1"; say "━━" "phase $(phase_no "$1")/9 · $1 – $(phase_desc "$1") · usually $(phase_time "$1")"; }
PHASE_SECONDS=0
run_phase() {  # phase [arguments] → header, phase, duration in PHASE_SECONDS
  local x="$1" t0=$SECONDS; shift
  phase_header "$x"
  "phase_$x" "$@"
  PHASE_SECONDS=$((SECONDS - t0))
}
phase_done_hint() {  # phase → duration and the command to run next
  local n; n=$(next_of "$1")
  ok "phase $1 done ($(dur "$PHASE_SECONDS"))"
  [ -n "$n" ] || return 0
  hint "next: ./reproduce $n – $(phase_desc "$n") · usually $(phase_time "$n")$(in_background "$n" && echo " · runs in the background")"
}
# ── Estimate of the remaining time (plans: stages × stage length; measured overheads) ─
plan_minutes() {  # configuration → minutes of one run: stages × stage length + reset, drain and collection
  local f="$SRC/experiments/plans/$(plan_of "$1").env" n d
  [ -r "$f" ] || { echo 165; return 0; }
  n=$(sed -n 's/^RATES="\(.*\)"/\1/p' "$f" | tr ',' '\n' | grep -c .)
  d=$(sed -n 's/^STAGE_DURATION="\(.*\)"/\1/p' "$f"); ! is_short || d=2
  echo $(( n * ${d:-10} + 15 ))
}
eta_minutes() {  # → "remaining extra total" in minutes: nominal plan minus the time already spent in the running step
  local p m=0 x=0 t c v i rd r reps dep ph="" el=0 since run rs
  p=$(profile); [ -n "$p" ] || { echo "0 0 0"; return 0; }
  reps=$(eff_reps); dep=$( [ "$p" = original ] && echo 30 || echo 45 )
  if job_alive; then ph=$(job_field phase); since=$(job_field since); [ -z "$since" ] || el=$(( ($(date +%s) - since) / 60 )); fi
  t=$((15 + dep + 20 + 5))
  phase_state install || m=$((m + 15))
  if ! phase_state deploy;  then if [ "$ph" = deploy ];  then m=$((m + (dep - el > 3 ? dep - el : 3))); else m=$((m + dep)); fi; fi
  if ! phase_state prepare; then if [ "$ph" = prepare ]; then m=$((m + (20 - el > 3 ? 20 - el : 3))); else m=$((m + 20)); fi; fi
  rd=$(cat "$STATE/results-current" 2>/dev/null || true)
  for c in $(configs_of "$p"); do
    r=$(plan_minutes "$c"); t=$((t + 30 + reps * r))
    v=0; i=0; if [ -n "$rd" ] && [ -d "$rd" ]; then read -r v i <<<"$(count_runs "$rd" "$c")"; fi
    [ "$v" -lt "$reps" ] || continue
    m=$((m + 30 + (reps - v) * r))                                   # 30: configuration change, check, log probe
    x=$((x + (MAX_REPLACEMENTS - (i < MAX_REPLACEMENTS ? i : MAX_REPLACEMENTS)) * r))
  done
  if marker_has run; then   # a run is in progress: its elapsed minutes are done
    run=$(basename "$(marker_get run)"); rs=$(date -u -d "${run:0:10} ${run:11:2}:${run:13:2}" +%s 2>/dev/null || true)
    if [ -n "$rs" ]; then
      el=$(( ($(date +%s) - rs) / 60 )); r=$(plan_minutes "$(echo "$run" | sed 's/^[0-9-]*_[0-9]*_\(.*\)_rep-.*/\1/')")
      m=$((m - (el < r - 5 ? el : r - 5)))
    fi
  fi
  [ "$m" -gt 0 ] || m=0
  echo "$(( m > 0 ? m + 5 : 0 )) $x $t"
}
hm() { printf '%d h %02d min' $(($1 / 60)) $(($1 % 60)); }
at_time() {  # minutes from now → clock time (local time of this machine, UTC in brackets if different)
  local l u; l=$(date -d "+$1 min" '+%H:%M %Z on %a %d %b'); u=$(date -u -d "+$1 min" '+%H:%M UTC')
  case "$l" in *UTC*) echo "$l" ;; *) echo "$l ($u)" ;; esac
}
eta_line() {  # → readable estimate, empty if nothing is left
  local m x t; read -r m x t <<<"$(eta_minutes)"
  [ "$m" -gt 5 ] || return 0
  echo "about $(hm "$m") left → done around $(at_time "$m")$( [ "$x" -gt 0 ] && echo "; each invalid run that must be repeated adds about $(hm "$(plan_minutes "$(configs_of "$(profile)" | awk '{print $1}')")")")"
}
eta_info() { local e; e=$(eta_line); [ -z "$e" ] || info "estimate: $e"; return 0; }
SUDO_KEEP=""
sudo_once() {  # ask for the sudo password now and keep it valid until the background part starts
  sudo -n true 2>/dev/null || { info "sudo password needed once now – for phase install (k3s, swap, automatic updates)"; sudo -v || die "sudo not available" 3; }
  ( while sleep 60; do sudo -n -v 2>/dev/null || exit 0; done ) & SUDO_KEEP=$!
}
banner() {
  [ "$BG" != 1 ] || return 0
  printf '%s\n' "${C_B}reproduce – PURIS saturation experiment, from an empty Ubuntu server to checked results${C_0}"
  printf '%s\n' "${C_DIM}  phases   0 fetch · 1 tools · 2 check · 3 install (sudo) · 4 deploy · 5 prepare · 6 verify · 7 measure · 8 evaluate · 9 package${C_0}"
  printf '%s\n' "${C_DIM}  from phase 4 on the job runs in the background: closing the terminal or losing SSH does not stop it${C_0}"
  printf '%s\n' "${C_DIM}  symbols  ✓ done · ↷ already done, skipped · … working · · information · ! warning · ✗ error · → next step${C_0}"
  [ "${REPRODUCE_SMOKE:-0}" != 1 ] || warn "short test mode (REPRODUCE_SMOKE=1): stages of 2 min, $REPS run(s) per configuration – results are not valid for the thesis"
  if [ -z "${TMUX:-}" ] && [ -z "${STY:-}" ]; then
    warn "not running inside tmux: keep this terminal connected for the first ~20 min (until the background job starts)"
    info "recommended: Ctrl-C now, then start again inside tmux: tmux new -s repro, then ./reproduce – it can then be left with Ctrl-b d and the computer switched off"
  else
    info "running inside tmux: once the estimate of the end is shown, leave with Ctrl-b d – the computer can then be switched off"
  fi
  return 0
}

# ── Embedded helper (Python 3, standard library + PyYAML) ─────────────────────────
IFS= read -r -d '' PY <<'PYCODE' || true
import sys, os, json, re, csv, gzip, math, time, hashlib, subprocess, statistics, shutil, platform
import urllib.parse, urllib.request, urllib.error, base64
from datetime import datetime, timezone, timedelta

def kubectl(*a, timeout=60, inp=None):
    r = subprocess.run(["kubectl", "--request-timeout=30s", *a], capture_output=True, text=True, timeout=timeout, input=inp)
    if r.returncode:
        raise RuntimeError("kubectl %s: %s" % (" ".join(a[:3]), r.stderr.strip()[-300:]))
    return r.stdout
def kraw(path): return kubectl("get", "--raw", path)
def iso(dt): return dt.isoformat(timespec="milliseconds").replace("+00:00", "Z")
def parse(s): return datetime.fromisoformat(s.replace("Z", "+00:00"))
def nsec(dt): return (dt - datetime(1970, 1, 1, tzinfo=timezone.utc)) // timedelta(microseconds=1) * 1000
def wjson(path, obj):
    with open(path, "w") as f: json.dump(obj, f, indent=1)
def rjson(path):
    with open(path) as f: return json.load(f)
def log(msg): print("%s … %s" % (datetime.now(timezone.utc).strftime("%H:%M:%S"), msg), flush=True)

def cpu_q(v):
    if v is None: return None
    s = str(v)
    return float(s[:-1]) / 1000 if s.endswith("m") else float(s)
def mem_q(v):
    if v is None: return None
    s = str(v); units = {"Ki": 2**10, "Mi": 2**20, "Gi": 2**30, "Ti": 2**40, "k": 1e3, "K": 1e3, "M": 1e6, "G": 1e9, "T": 1e12}
    for u in sorted(units, key=len, reverse=True):
        if s.endswith(u): return float(s[:-len(u)]) * units[u]
    return float(s)

# ---------- values: profile original = chart defaults for resources ----------
def cmd_strip(src, dst):
    import yaml
    def s(n):
        if isinstance(n, dict):
            return {k: s(v) for k, v in n.items() if k not in ("resources", "resourcesPreset", "JAVA_TOOL_OPTIONS")}
        if isinstance(n, list):
            return [s(x) for x in n if not (isinstance(x, dict) and x.get("name") == "JAVA_TOOL_OPTIONS")]
        return n
    with open(src) as f: data = yaml.safe_load(f) or {}
    with open(dst, "w") as f: yaml.safe_dump(s(data), f, sort_keys=False)

def docs(path):
    import yaml
    with open(path) as f: return [d for d in yaml.safe_load_all(f) if isinstance(d, dict)]

def pod_specs(d):
    kind = d.get("kind"); hook = ((d.get("metadata") or {}).get("annotations") or {}).get("helm.sh/hook")
    if hook: return
    name = (d.get("metadata") or {}).get("name", "")
    if kind in ("Deployment", "StatefulSet", "DaemonSet"):
        reps = 1 if kind == "DaemonSet" else d["spec"].get("replicas", 1)
        yield kind, name, reps, d["spec"]["template"]["spec"]
    elif kind == "Prometheus":
        sp = d.get("spec") or {}
        yield kind, name, sp.get("replicas", 1), {"containers": [
            {"name": "prometheus", "resources": sp.get("resources") or {}},
            {"name": "config-reloader", "resources": {"requests": {"cpu": "50m", "memory": "64Mi"}, "limits": {"cpu": "50m", "memory": "64Mi"}}}]}

ASSUMED_CPU, ASSUMED_MEM = 0.1, 0.25 * 2**30          # containers without limit (REPRODUCE.md §8)
def cmd_footprint(*manifests):
    tot = {"limits_cpu": 0.0, "limits_mem": 0.0, "requests_cpu": 0.0, "requests_mem": 0.0}
    unlimited = []
    for m in manifests:
        for d in docs(m):
            for kind, name, reps, spec in pod_specs(d):
                if not reps: continue
                agg = {}
                for group in ("containers", "initContainers"):
                    vals = []
                    for c in spec.get(group) or []:
                        r = c.get("resources") or {}; rq = r.get("requests") or {}; lm = r.get("limits") or {}
                        lc, lmem = cpu_q(lm.get("cpu")), mem_q(lm.get("memory"))
                        if lc is None or lmem is None:
                            unlimited.append("%s/%s" % (name, c.get("name")))
                        vals.append((cpu_q(rq.get("cpu")) or 0, mem_q(rq.get("memory")) or 0,
                                     lc if lc is not None else ASSUMED_CPU, lmem if lmem is not None else ASSUMED_MEM))
                    agg[group] = vals
                for i, key in enumerate(("requests_cpu", "requests_mem", "limits_cpu", "limits_mem")):
                    app = sum(v[i] for v in agg["containers"]); init = max([v[i] for v in agg["initContainers"]] or [0])
                    tot[key] += max(app, init) * reps
    # k3s pods (CoreDNS, metrics-server) and the k6 runner during a run
    tot["limits_cpu"] += 0.2 + 0.5; tot["limits_mem"] += 0.25 * 2**30 + 0.5 * 2**30
    print(json.dumps({"limits_cpu": round(tot["limits_cpu"], 3), "limits_mem_gib": round(tot["limits_mem"] / 2**30, 3),
                      "requests_cpu": round(tot["requests_cpu"], 3), "requests_mem_gib": round(tot["requests_mem"] / 2**30, 3),
                      "unlimited_assumed": sorted(set(unlimited))}))

def cmd_images(*manifests):
    out = set()
    for m in manifests:
        for d in docs(m):
            sp = d.get("spec") or {}
            if d.get("kind") == "Prometheus" and sp.get("image"): out.add(sp["image"])
            tpl = ((sp.get("template") or {}).get("spec")) or {}
            for c in (tpl.get("containers") or []) + (tpl.get("initContainers") or []):
                if c.get("image"): out.add(c["image"])
                for a in c.get("args") or []:
                    if isinstance(a, str) and a.startswith("--prometheus-config-reloader="): out.add(a.split("=", 1)[1])
    print("\n".join(sorted(out)))

def norm(r):
    r = r or {}; o = {}
    for k in ("requests", "limits"):
        x = r.get(k) or {}
        o[k] = (round(cpu_q(x.get("cpu")) or 0, 4) if x.get("cpu") is not None else None,
                int(mem_q(x.get("memory"))) if x.get("memory") is not None else None)
    return o
def cmd_conformance(ns, manifest):
    expected = {}
    for d in docs(manifest):
        for kind, name, reps, spec in pod_specs(d):
            if kind == "Prometheus":
                expected[("Prometheus", name, "prometheus")] = norm(spec["containers"][0]["resources"]); continue
            for c in (spec.get("containers") or []):
                expected[(kind, name, c["name"])] = norm(c.get("resources"))
    live = {}
    for kind, res in (("Deployment", "deploy"), ("StatefulSet", "sts"), ("DaemonSet", "ds")):
        for it in json.loads(kubectl("get", res, "-n", ns, "-o", "json"))["items"]:
            for c in it["spec"]["template"]["spec"]["containers"]:
                live[(kind, it["metadata"]["name"], c["name"])] = norm(c.get("resources"))
    if any(k[0] == "Prometheus" for k in expected):
        for it in json.loads(kubectl("get", "prometheus", "-n", ns, "-o", "json"))["items"]:
            live[("Prometheus", it["metadata"]["name"], "prometheus")] = norm((it.get("spec") or {}).get("resources"))
    diffs = ["%s/%s/%s: expected %s, running %s" % (k[0], k[1], k[2], v, live.get(k)) for k, v in sorted(expected.items()) if live.get(k) != v]
    print("\n".join(diffs)); sys.exit(1 if diffs else 0)

