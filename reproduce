                if os.environ.get("REPRODUCE_TITLE") == "1": term("\033]2;reproduce · %s%s\a" % ((job or {}).get("phase", "idle").split(":")[0], " · %d %%" % pct if job else ""))
                if os.environ.get("REPRODUCE_TPROG") == "1": term("\033]9;4;%s\a" % ("1;%d" % pct if job else "0;0"))
