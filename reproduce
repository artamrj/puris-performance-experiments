def cmd_dashboard(script, logf, once=""):
    # full-screen live view (curses, standard library); design: REPRODUCE.md §4.1
    import threading, signal as sig
    once = once == "once"
    STATUS = re.compile(r"^(\d\d):(\d\d):(\d\d) (\S+) ")
    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    NS = ["monitoring", "logging", "identity", "customer", "supplier", "k6-operator", "k6"]
    W = {"snap": None, "pods": None, "node": None, "t": 0.0, "kube": True, "pct": 0}
    MODE = {"view": "main", "confirm": False, "all": False, "off": 0, "msg": "", "msg_t": 0.0}
    L = threading.Lock(); wake = threading.Event()
    COLOR = os.environ.get("REPRODUCE_COLOR") == "1"

    def run(cmd, timeout):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            return r.stdout if r.returncode == 0 else None
        except Exception:
            return None
    def parse_node(n):
        try:
            f = n.split(); u = {"Ki": 1 / 1048576, "Mi": 1 / 1024, "Gi": 1.0, "Ti": 1024.0}
            cpu = float(f[1][:-1]) / 1000 if f[1].endswith("m") else float(f[1])
            mem = next(float(f[3][:-2]) * u[k] for k in u if f[3].endswith(k))
            return {"cpu": cpu, "cpu_pct": int(f[2].rstrip("%")), "mem": mem, "mem_pct": int(f[4].rstrip("%"))}
        except Exception:
            return None
    def fetch():
        s_ = run(["bash", script, "_snapshot"], 60)
        p_ = run(["kubectl", "--request-timeout=5s", "get", "pods", "-A", "-o", "json"], 15)
        n_ = run(["kubectl", "--request-timeout=5s", "top", "node", "--no-headers"], 15)
        try: snap = json.loads(s_) if s_ else None
        except ValueError: snap = None
        try: pods = json.loads(p_)["items"] if p_ else None
        except (ValueError, KeyError): pods = None
        with L:
            if snap is not None: W["snap"] = snap
            W["pods"], W["node"], W["kube"], W["t"] = pods, parse_node(n_), p_ is not None, time.time()
    def loop():
        while True:
            fetch(); wake.wait(3); wake.clear()
    def log_lines(everything=False):
        try:
            with open(logf, "rb") as f:
                f.seek(0, 2); size = f.tell(); f.seek(max(0, size - 300000)); data = f.read().decode("utf-8", "replace")
        except OSError:
            return []
        ls = data.splitlines()[1 if size > 300000 else 0:]
        return ls if everything else [l for l in ls if STATUS.match(l)]
    def line_epoch(l, now):
        m = STATUS.match(l)
        if not m: return now
        g = time.gmtime(now); mid = now - (g.tm_hour * 3600 + g.tm_min * 60 + g.tm_sec)
        e = mid + int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3))
        return e - 86400 if e > now + 60 else e
    def dur(x):
        x = int(max(0, x)); return "%dm%02ds" % (x // 60, x % 60) if x < 3600 else "%dh%02dm" % (x // 3600, x % 3600 // 60)
    def hm(m): return "%d h %02d min" % (m // 60, m % 60) if m >= 60 else "%d min" % m
    def clock(e):
        lt = time.localtime(e); z = time.strftime("%Z", lt)
        return time.strftime("%H:%M ", lt) + z + time.strftime(" %a %d %b", lt) + ("" if z == "UTC" else time.strftime(" (%H:%M UTC)", time.gmtime(e)))
    def flash(m): MODE["msg"], MODE["msg_t"] = m, time.time()
    def cut(t, n): return t if len(t) <= n else (t[:max(0, n - 1)] + "…" if n > 0 else "")

    class Canvas:
        def __init__(c, w, h): c.w, c.h, c.items = w, h, []
        def put(c, y, x, text, st=""):
            if 0 <= y < c.h and 0 <= x < c.w and text: c.items.append((y, x, text[:c.w - x], st))
            return x + len(text)
        def right(c, y, text, st=""): return c.put(y, max(0, c.w - len(text) - 1), text, st)
    SYM = {"✓": "ok", "✗": "err", "!": "warn", "…": "acc", "▶": "acc", "→": "b", "↷": "d", "·": "d"}
    def log_row(c, y, x, l, width):
        m = STATUS.match(l)
        if not m: c.put(y, x, l[:width], "d"); return
        sym, body = m.group(4), l[m.end():]
        c.put(y, x, l[:8], "d")
        if sym.startswith("━"): c.put(y, x + 9, (sym + " " + body)[:max(0, width - 9)], "b"); return
        st = SYM.get(sym, ""); c.put(y, x + 9, sym, st)
        c.put(y, x + 11, cut(body, width - 11), st if st in ("err", "warn", "d", "b") else "")
    def pod_state(p):
        st = p.get("status") or {}; ph = st.get("phase")
        if ph == "Succeeded": return "done", "completed"
        cs = st.get("containerStatuses") or []
        for c_ in (st.get("initContainerStatuses") or []) + cs:
            w_ = (c_.get("state") or {}).get("waiting") or {}
            if w_.get("reason") in ("CrashLoopBackOff", "ImagePullBackOff", "ErrImagePull", "CreateContainerConfigError", "CreateContainerError", "InvalidImageName", "RunContainerError"):
                return "bad", w_["reason"]
        if ph == "Failed": return "bad", "failed"
        if cs and all(c_.get("ready") for c_ in cs): return "ok", "ready"
        for c_ in cs:
            w_ = (c_.get("state") or {}).get("waiting") or {}
